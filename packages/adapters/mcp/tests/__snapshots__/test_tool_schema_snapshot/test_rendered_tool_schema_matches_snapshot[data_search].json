{
  "description": [
    "Search the data sources for `query`; only what everyone who will see the answer may",
    "read. Filter by source ids (`data_sources`), record kind and date range. Each hit has a",
    "`record_id` to open with `data_get`; `live` holds what live sources answered now. No",
    "hit is not proof that nothing exists."
  ],
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "kind": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "limit": {
        "default": 10,
        "type": "integer"
      },
      "query": {
        "type": "string"
      },
      "since": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "source_ids": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "until": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "query"
    ],
    "type": "object"
  }
}
