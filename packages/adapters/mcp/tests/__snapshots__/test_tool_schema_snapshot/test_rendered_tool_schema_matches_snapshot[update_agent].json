{
  "description": [
    "Update an agent: change its instructions (system prompt), switch its model, or",
    "add existing skills such as build-models. Scalar ``model``, ``description``",
    "and ``system`` fields replace. Outside chat ``model`` may be any",
    "``list_models`` model, another provider's too; in chat move providers with",
    "``request_agent_backend_switch``.",
    "",
    "Prefer current-generation ``claude-sonnet-5-5`` for Sonnet,",
    "``claude-opus-5-5`` for Opus and ``claude-haiku-5-5`` for the cheapest",
    "Claude unless an older version is explicitly requested. List fields",
    "(``tools``, ``mcp_servers``, ``skills``) are added to, never replaced; shorter",
    "lists remove nothing. Use ``remove_skill`` or ``detach_mcp_server`` to remove.",
    "Daimon requires ``fork_agent`` first. Needs the agent's owner (whoever created it",
    "in chat, or whom an admin named) or an admin.",
    "",
    "Prompt, model and skill changes reach a conversation on its next message, not the",
    "one running now. ``skills`` accepts names such as",
    "``[\"build-models\", \"compare-models\"]``, resolved server-side; explicit",
    "``{\"type\": \"custom\", \"skill_id\": \"skill_...\"}`` entries also work. A model or",
    "prompt change also returns ``applies``: post it verbatim as part of the reply.",
    "Pass this turn's ``origin_context_id`` so its channel counts."
  ],
  "parameters": {
    "$defs": {
      "BetaManagedAgentsAgentToolConfigParams": {
        "description": "Configuration override for a specific tool within a toolset.",
        "properties": {
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "enum": [
              "bash",
              "edit",
              "read",
              "write",
              "glob",
              "grep",
              "web_fetch",
              "web_search"
            ],
            "type": "string"
          },
          "permission_policy": {
            "anyOf": [
              {
                "$ref": "#/$defs/BetaManagedAgentsAlwaysAllowPolicyParam"
              },
              {
                "$ref": "#/$defs/BetaManagedAgentsAlwaysAskPolicyParam"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "BetaManagedAgentsAgentToolset20260401Params": {
        "description": "Configuration for built-in agent tools.\n\nUse this to enable or disable groups of tools available to the agent.",
        "properties": {
          "configs": {
            "items": {
              "$ref": "#/$defs/BetaManagedAgentsAgentToolConfigParams"
            },
            "type": "array"
          },
          "default_config": {
            "anyOf": [
              {
                "$ref": "#/$defs/BetaManagedAgentsAgentToolsetDefaultConfigParams"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "const": "agent_toolset_20260401",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "BetaManagedAgentsAgentToolsetDefaultConfigParams": {
        "description": "Default configuration for all tools in a toolset.",
        "properties": {
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "permission_policy": {
            "anyOf": [
              {
                "$ref": "#/$defs/BetaManagedAgentsAlwaysAllowPolicyParam"
              },
              {
                "$ref": "#/$defs/BetaManagedAgentsAlwaysAskPolicyParam"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "BetaManagedAgentsAlwaysAllowPolicyParam": {
        "description": "Tool calls are automatically approved without user confirmation.",
        "properties": {
          "type": {
            "const": "always_allow",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "BetaManagedAgentsAlwaysAskPolicyParam": {
        "description": "Tool calls require user confirmation before execution.",
        "properties": {
          "type": {
            "const": "always_ask",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "BetaManagedAgentsAnthropicSkillParams": {
        "description": "An Anthropic-managed skill.",
        "properties": {
          "skill_id": {
            "type": "string"
          },
          "type": {
            "const": "anthropic",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "skill_id",
          "type"
        ],
        "type": "object"
      },
      "BetaManagedAgentsCustomSkillParams": {
        "description": "A user-created custom skill.",
        "properties": {
          "skill_id": {
            "type": "string"
          },
          "type": {
            "const": "custom",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "skill_id",
          "type"
        ],
        "type": "object"
      },
      "BetaManagedAgentsCustomToolInputSchemaParam": {
        "additionalProperties": true,
        "description": "JSON Schema for custom tool input parameters.",
        "properties": {
          "properties": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "required": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "const": "object",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "BetaManagedAgentsCustomToolParams": {
        "description": "A custom tool that is executed by the API client rather than the agent.\n\nWhen the agent calls this tool, an `agent.custom_tool_use` event is emitted and the session goes idle, waiting for the client to provide the result via a `user.custom_tool_result` event.",
        "properties": {
          "description": {
            "type": "string"
          },
          "input_schema": {
            "$ref": "#/$defs/BetaManagedAgentsCustomToolInputSchemaParam"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "const": "custom",
            "type": "string"
          }
        },
        "required": [
          "description",
          "input_schema",
          "name",
          "type"
        ],
        "type": "object"
      },
      "BetaManagedAgentsMCPToolConfigParams": {
        "description": "Configuration override for a specific MCP tool.",
        "properties": {
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "permission_policy": {
            "anyOf": [
              {
                "$ref": "#/$defs/BetaManagedAgentsAlwaysAllowPolicyParam"
