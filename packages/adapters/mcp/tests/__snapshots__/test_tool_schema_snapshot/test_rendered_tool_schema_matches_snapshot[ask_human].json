{
  "description": [
    "Ask a person a question from your workflow step, then end your turn.",
    "",
    "Only when the step allows questions, one open at a time and at most 3 a step.",
    "`options` offers answers to pick from; `fields` asks for typed answers instead,",
    "each a choice (with `choices`) or free text, such as a channel and a note.",
    "The answer arrives as your next message; carry on with the step from there."
  ],
  "parameters": {
    "$defs": {
      "AskField": {
        "description": "One typed answer field of `ask_human`: a choice when `choices` is set, else free text.",
        "properties": {
          "choices": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 25,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "name": {
            "description": "Key in the answer",
            "pattern": "^[a-z][a-z0-9_]{0,39}$",
            "type": "string"
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "title": {
            "description": "Label the person sees",
            "maxLength": 45,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "title"
        ],
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "fields": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/$defs/AskField"
            },
            "maxItems": 5,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "options": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "question": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "step": {
        "format": "uuid",
        "type": "string"
      }
    },
    "required": [
      "step",
      "question"
    ],
    "type": "object"
  }
}
