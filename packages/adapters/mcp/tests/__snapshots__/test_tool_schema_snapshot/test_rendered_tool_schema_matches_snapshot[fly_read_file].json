{
  "description": [
    "Read a file from your session in byte chunks. This does not extend its lease."
  ],
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "limit": {
        "default": 65536,
        "type": "integer"
      },
      "offset": {
        "default": 0,
        "type": "integer"
      },
      "origin_context_id": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "session_id": {
        "format": "uuid",
        "type": "string"
      }
    },
    "required": [
      "session_id",
      "path",
      "origin_context_id"
    ],
    "type": "object"
  }
}
