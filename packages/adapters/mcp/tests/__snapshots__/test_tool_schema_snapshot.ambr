    'update_plan': dict({
      'description': '''
        Show the task's plan as a checklist on the progress card.
        <blank line>
        Use it only when this turn's progress_plans block says progress plans
        are on; otherwise nothing is shown. Send the whole list each time, in
        order, with at most one step in_progress. Updating the plan is not a
        reply: carry on with the task afterwards.
      ''',
      'parameters': dict({
        '$defs': dict({
          'PlanStep': dict({
            'additionalProperties': False,
            'description': 'One step of the plan, as the person reads it on the card.',
            'properties': dict({
              'status': dict({
                'enum': list([
                  'pending',
                  'in_progress',
                  'completed',
                ]),
                'type': 'string',
              }),
              'step': dict({
                'description': 'A few plain words.',
                'maxLength': 120,
                'minLength': 1,
                'type': 'string',
              }),
            }),
            'required': list([
              'step',
              'status',
            ]),
            'type': 'object',
          }),
        }),
        'additionalProperties': False,
        'properties': dict({
          'steps': dict({
            'items': dict({
              '$ref': '#/$defs/PlanStep',
            }),
            'maxItems': 12,
            'minItems': 1,
            'type': 'array',
          }),
        }),
        'required': list([
          'steps',
        ]),
        'type': 'object',
      }),
    }),
    'update_routine': dict({
      'description': '''
        PATCH-update a routine, including owner-only DM delivery where supported.
        <blank line>
        Only provided fields are changed.
        <blank line>
        ``destination_kind`` + ``destination_id`` set where results go (see
        ``create_routine``); ``clear_destination=true`` removes it, and the
        routine's spend still counts toward the same channel's budget. Saved
        creation-time source channel/thread restrictions survive every edit.
        Legacy routines with unknown provenance keep ordinary destination edits
        but must be recreated from the source channel/thread to select DM delivery.
        <blank line>
        ``catch_up_policy`` selects ``skip`` or one coalesced ``run-once`` after downtime.
        <blank line>
        ``agent_name`` reassigns the routine to a different daimon-tagged agent;
        the tool resolves it to a live MA agent id at the call boundary.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'agent_name': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'catch_up_policy': dict({
            'anyOf': list([
              dict({
                'enum': list([
                  'skip',
                  'run-once',
