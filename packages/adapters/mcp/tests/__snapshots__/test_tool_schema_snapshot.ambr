          }),
          'BetaManagedAgentsCustomToolInputSchemaParam': dict({
            'additionalProperties': True,
            'description': 'JSON Schema for custom tool input parameters.',
            'properties': dict({
              'properties': dict({
                'anyOf': list([
                  dict({
                    'additionalProperties': True,
                    'type': 'object',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'required': dict({
                'anyOf': list([
                  dict({
                    'items': dict({
                      'type': 'string',
                    }),
                    'type': 'array',
