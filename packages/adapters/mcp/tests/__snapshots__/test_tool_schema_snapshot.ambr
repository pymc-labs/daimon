                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'clear_destination': dict({
            'default': False,
            'type': 'boolean',
          }),
          'cron_expr': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'destination_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'destination_kind': dict({
            'anyOf': list([
              dict({
                'enum': list([
                  'channel',
                  'thread',
                  'dm',
                ]),
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'enabled': dict({
            'anyOf': list([
              dict({
                'type': 'boolean',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'routine_id': dict({
            'format': 'uuid',
            'type': 'string',
