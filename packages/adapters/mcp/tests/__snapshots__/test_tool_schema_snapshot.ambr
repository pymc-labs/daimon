                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
                'default': None,
              }),
              'description': dict({
                'anyOf': list([
                  dict({
                    'type': 'string',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
                'default': None,
              }),
              'name': dict({
                'type': 'string',
              }),
              'scope': dict({
                'anyOf': list([
                  dict({
                    'enum': list([
                      'organization',
                      'account',
                    ]),
                    'type': 'string',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
                'default': None,
              }),
            }),
            'required': list([
              'name',
            ]),
            'type': 'object',
          }),
        }),
        'additionalProperties': False,
        'properties': dict({
          'spec': dict({
            '$ref': '#/$defs/EnvironmentSpec',
          }),
        }),
        'required': list([
          'spec',
        ]),
        'type': 'object',
      }),
    }),
    'create_file_upload_url': dict({
      'description': '''
        Post, send, or share a file to another channel, or from a routine — step 1 of 2.
        <blank line>
        Not for attaching a file to your reply. In the chat you were invoked
        from, save the file under
        /mnt/session/outputs/ and daimon attaches it to your reply after the
        turn; posting it into that thread with this tool delivers a duplicate.
        Use this tool for a file you were asked to post to a channel or thread
        you were not invoked from, or from a scheduled routine, which has no
        reply to attach to.
        <blank line>
        The intent words are in this first line on purpose: an agent looking
        for "post a file" has to find this tool by search and read where the
        file should go, and the name alone does not carry any of that.
        <blank line>
        Call this FIRST, then send the bytes from your sandbox with curl:
        <blank line>
            curl -sS -X PUT --data-binary @chart.png "<upload_url>"
        <blank line>
        Do NOT base64 the file into a tool argument. The bytes go straight from
        your sandbox over HTTP; they never pass through your context, so a large
        file costs you nothing and cannot be truncated in transit.
        <blank line>
        ``mime_type`` is required (e.g. "image/png", "text/csv") — it is not
        guessed, since a wrong one produces a wrong file extension.
        <blank line>
        Returns an ``upload_url`` and a ``handle_id``. After the PUT succeeds,
        pass the handle id to ``send_message``'s ``file_handles`` argument to
        post it, in the channel the user named — never into a channel they did
        not name. The URL is
        single-use and expires; mint a new one per file.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'mime_type': dict({
            'type': 'string',
          }),
          'title': dict({
            'type': 'string',
          }),
        }),
        'required': list([
          'title',
          'mime_type',
        ]),
        'type': 'object',
      }),
    }),
    'create_notebook_upload_url': dict({
      'description': '''
        Mint a one-time upload URL for a marimo notebook.
        <blank line>
        Get your notebook's .py into a sandbox file (author it incrementally with
        write/edit + read-back, or curl it from an origin), then PUT the file to the
        returned upload_url — the source never goes through a tool argument (which
        truncates large notebooks).
        <blank line>
        permanent=False (default) publishes a scratch notebook that the host deletes
        after ttl_days: 1 by default, up to 365. Pick a longer ttl_days when the
        person needs the link for longer, such as a client review or a report that
        links to it. permanent=True publishes it as a blog, kept until you delete it.
        Prefer the default; re-upload the same slug with permanent=True once the
        notebook is worth keeping. Re-uploading a scratch notebook restarts its
        ttl_days from now; re-uploading a blog keeps it a blog.
        <blank line>
        Either survives host restarts. The host stops a notebook nobody has opened
        for a couple of hours, so opening a quiet link can take a few seconds while
        it starts again.
        <blank line>
        Both are read-only apps by default: code hidden, interactive widgets live.
        editable=True (scratch only, and only where the operator has turned it on)
        serves the marimo code editor instead. Anyone holding that link can run
        arbitrary code on the notebook host, so pass it only when the person you
        are sharing with asked to edit the notebook.
        <blank line>
        Returns {upload_url, slug, upload_expires_at}. upload_expires_at is when the
        upload URL stops working (~5 min), not the notebook; use it promptly. Pass
        slug to reuse a stable URL across iterations, or omit it for a fresh random
        one.
        <blank line>
        Then upload with: curl -sS -X PUT --data-binary @<file> "<upload_url>". The
        curl response JSON carries the live url and expires_at (null for a blog);
        share that whole url and say when it expires. Its access_token is the
        notebook's only key, so share it only where the notebook belongs. Never
        paste large file contents into a tool argument.
        <blank line>
        Pass this turn's origin_context_id. An agent with a rule (where it runs)
        publishes only once the requester approves the call on a card.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'editable': dict({
            'default': False,
            'type': 'boolean',
          }),
          'origin_context_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'permanent': dict({
            'default': False,
            'type': 'boolean',
          }),
          'slug': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'ttl_days': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
        }),
        'type': 'object',
      }),
    }),
    'create_promo_code': dict({
      'description': '''
        Create a promo code any workspace can redeem for credit. Operator-only.
        <blank line>
        ``amount_usd`` is the credit per redemption as a decimal string.
        ``credit`` codes stay until spent; ``timed`` codes need
        ``credit_starts_at`` and ``credit_ends_at`` and expire unspent credit
        at the end. Redemption is open between ``redeem_starts_at`` and
        ``redeem_ends_at`` when given (a timed code's defaults to its credit
        end). Dates are ISO 8601, UTC without an offset. ``code`` is shown
        only in this result.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'amount_usd': dict({
            'type': 'string',
          }),
          'credit_ends_at': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'credit_starts_at': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'kind': dict({
            'enum': list([
              'credit',
              'timed',
            ]),
            'type': 'string',
          }),
          'max_redemptions': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'note': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'redeem_ends_at': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'redeem_starts_at': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
        }),
        'required': list([
          'amount_usd',
          'kind',
        ]),
        'type': 'object',
      }),
    }),
    'create_routine': dict({
      'description': '''
        Create a recurring routine; owner DMs run as unattended live-DM turns.
        <blank line>
        Owner-DM routines are scheduled live-DM turns, using the owner's normal
        personal/shared memory, credentials and DM tool authority in a fresh private
        scope. They support Managed Agents only and run unattended: calls needing
        a person are refused, and nobody watches intermediate actions. Permitted
        tools retain ordinary DM side-effect risk. Crash and stop guarantees are
        exactly those of live DMs. A slot skips if the owner has a DM turn running.
        All other routines, including destination-free rows, mount shared memory
        only. Sources must be supported
        channels/threads in this tenant's guild; the original thread and parent
        remain subject to reader restrictions.
        <blank line>
        ``catch_up_policy`` is ``skip`` (default) or ``run-once`` after downtime.
        <blank line>
        ``destination_kind`` (``channel``, ``thread`` or ``dm``) and ``destination_id``
        optionally name where each run's result goes. Channel/thread runs are
        told where; if the agent does not post there itself, daimon posts the end
        of its final reply there. Owner-DM runs queue their successful final reply
        privately for the owner. Use the canonical thread identifier returned by
        this platform's read tools, in a channel you are in. Where DM delivery is
        supported, ``dm`` delivers only to the authenticated owner; omit
        ``destination_id`` to derive their user ID. Unsupported destinations are
        refused. Delivery status and failure reasons are returned by list/get.
        A protected channel is refused. Without a destination the
        result is only recorded (``last_result_tail``), as before. A run's
        spend counts toward the destination channel's budget, or without a
        destination the budget of the channel named by ``origin_context_id``
        (this turn's), and a run is skipped while that budget is used up.
        <blank line>
        ``agent_name`` MUST be the exact daimon-side display name of an
        existing agent on this tenant (e.g. ``"daimon"``, ``"daimon-copy"``,
        ``"research-bot"``). It is NOT:
        <blank line>
        - a free-text description of the routine
        - a mention, tag fragment, or user handle
        - a routine label or trigger phrase
        - the name of a tool, MCP, or skill
        <blank line>
        The tool resolves ``agent_name`` to a live MA agent id at the call
        boundary; an unknown name raises ``ToolError`` and the
        routine is not created. A non-admin may only name the agent they are
        talking to, or the agent the destination channel answers with.
        <blank line>
        If you are the calling agent and do not know which agent to bind the
        routine to, DEFAULT to your own name (the one you were addressed as
        in this conversation). Do NOT guess from context — if ambiguous, ask
        the user which agent should own the routine.
        <blank line>
        Example: a user says "daimon, create a routine that pings me every
        5 minutes with the message 'ping'". The correct call is
        ``create_routine(agent_name="daimon", cron_expr="*/5 * * * *",
        timezone="UTC", trigger_message="ping")``.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'agent_name': dict({
            'type': 'string',
          }),
          'catch_up_policy': dict({
            'default': 'skip',
            'enum': list([
              'skip',
              'run-once',
            ]),
            'type': 'string',
          }),
          'cron_expr': dict({
            'type': 'string',
          }),
          'destination_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'destination_kind': dict({
            'anyOf': list([
              dict({
                'enum': list([
                  'channel',
                  'thread',
                  'dm',
                ]),
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'enabled': dict({
            'default': True,
            'type': 'boolean',
          }),
          'origin_context_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'timezone': dict({
            'type': 'string',
          }),
          'trigger_message': dict({
            'type': 'string',
          }),
        }),
        'required': list([
          'agent_name',
          'cron_expr',
          'timezone',
          'trigger_message',
        ]),
        'type': 'object',
      }),
    }),
    'create_thread': dict({
      'description': '''
        Create a new thread and post content as its first message.
        <blank line>
        ``content`` is required and becomes the thread's first message; a thread
        cannot open without one. ``name`` is the thread's title (1-100 characters)
        where threads have titles, and is ignored elsewhere. On a text channel this
        creates a PUBLIC thread; on a forum channel it creates a post. Pass
        channel_id as turn_controls gives it (``parent_channel_id``, no
        ``;messageid=``). Text only, and you must be a member of the channel.
        <blank line>
        The result names the new thread. If it returns a ``conversation_id``, pass
        that as ``channel_id`` to send_message to reply in it. If it returns only a
        ``ts``, address the thread as the composite ``channel_id:ts`` in send_message
        and read_thread (e.g. a ``ts`` of ``1717171717.123456`` in channel
        ``C0123456789`` is ``C0123456789:1717171717.123456``).
        <blank line>
        Only create a thread when the user asked for one. Refused in channels the
        workspace marked protected.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'channel_id': dict({
            'type': 'string',
          }),
          'content': dict({
            'type': 'string',
          }),
          'name': dict({
            'type': 'string',
          }),
        }),
        'required': list([
          'channel_id',
          'name',
          'content',
        ]),
        'type': 'object',
      }),
    }),
    'create_timer': dict({
      'description': '''
        Come back to this conversation once, later: "remind me in two hours", "check back tomorrow at 9".
        <blank line>
        At `fire_at` you get one new turn in this same thread, with its context
        and your `note` as the message, as the person who asked. It fires once;
        for anything that repeats ("every Monday"), use `create_routine`.
        <blank line>
        `fire_at` needs an explicit offset; use the time tools to work it out
        from the person's timezone. One minute to 90 days ahead. `note` is all
        you get besides the thread, so name what to check and what to report.
        Tell the person when it will fire and how to cancel it.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'fire_at': dict({
            'description': 'ISO 8601 with a UTC offset, e.g. 2026-09-29T09:00:00+02:00.',
            'type': 'string',
          }),
          'note': dict({
            'description': 'What to do when it fires, written for yourself, with the details.',
            'type': 'string',
          }),
          'origin_context_id': dict({
            'type': 'string',
          }),
        }),
        'required': list([
          'origin_context_id',
          'fire_at',
          'note',
        ]),
        'type': 'object',
      }),
    }),
    'create_watch': dict({
      'description': '''
        Watch an OS page event or a reviewed OS read tool from this conversation.
        <blank line>
        Binds the current human owner, tenant, agent and exact Discord thread.
        Requires an attended turn origin and verified owner card approval.
        Backends without tool confirmation refuse enrollment.
        Polls run without an AI turn; firings
        use unattended read-and-report turns and current access/spend checks.
        Poll arguments must explicitly name a source different from the reporting thread.
        Only read_thread and read_channel are pollable; no URLs or outside tools.
        Projection supports `.`, `.field.nested` and `.rows[0].field`; other jq
        expressions are refused. Polls start with a saved baseline and compare
        change, added array elements, or updated object keys every 60–86400 seconds.
        Lifetime is 1–30 days. Producers remain disabled until both operator gates
        are enabled. Page signing keys are sent privately to the owner once and
        never returned here; install them on the OS host and sidecar privately.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'arguments': dict({
            'anyOf': list([
              dict({
                'additionalProperties': True,
                'type': 'object',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'instructions': dict({
            'type': 'string',
          }),
          'interval': dict({
            'default': 300,
            'type': 'integer',
          }),
          'lifetime_days': dict({
            'default': 7,
            'type': 'integer',
          }),
          'origin_context_id': dict({
            'type': 'string',
          }),
          'page_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'projection': dict({
            'default': '.',
            'type': 'string',
          }),
          'rule': dict({
            'default': 'change',
            'enum': list([
              'change',
              'added',
              'updated',
            ]),
            'type': 'string',
          }),
          'source': dict({
            'enum': list([
              'page_event',
              'poll',
            ]),
            'type': 'string',
          }),
          'tool': dict({
            'default': 'read_thread',
            'type': 'string',
          }),
        }),
        'required': list([
          'origin_context_id',
          'instructions',
          'source',
        ]),
        'type': 'object',
      }),
    }),
