                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'content': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'has': dict({
            'anyOf': list([
              dict({
                'items': dict({
