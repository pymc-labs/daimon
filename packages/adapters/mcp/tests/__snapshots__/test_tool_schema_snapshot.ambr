                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'slug': dict({
            'type': 'string',
          }),
        }),
        'required': list([
          'slug',
          'name',
        ]),
        'type': 'object',
      }),
    }),
    'create_environment': dict({
      'description': '''
        Create a sandbox environment a channel or the workspace can later run in.
        <blank line>
        Packages are declared under ``spec.config.packages``, one list per
        ecosystem: ``apt``, ``cargo``, ``gem``, ``go``, ``npm``, ``pip``. For
        example, an environment with numpy, pandas, and pymc sets
        ``config.packages.pip = ["numpy", "pandas", "pymc"]``. Pin a version
        with the ecosystem's own syntax — for ``pip``, ``package==1.0.0``.
        <blank line>
        The package lists you send are the environment's complete package
        set, not a delta: a later change to these packages replaces rather
        than merges, so omitting a previously-installed package removes it.
        Always send the full intended list for every ecosystem you care about.
        <blank line>
        The new environment is inert until an admin picks it for a channel or
        the workspace, or a channel's admin picks it for their channel, with
        ``set_channel_environment``; creating one here changes nothing yet.
      ''',
      'parameters': dict({
        '$defs': dict({
          'BetaCloudConfigParams': dict({
            'additionalProperties': False,
            'description': '''
              Request params for `cloud` environment configuration.
              <blank line>
              Fields default to null; on update, omitted fields preserve the
              existing value.
            ''',
            'properties': dict({
              'networking': dict({
                'anyOf': list([
                  dict({
                    '$ref': '#/$defs/BetaUnrestrictedNetworkParam',
                  }),
                  dict({
                    '$ref': '#/$defs/BetaLimitedNetworkParams',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'packages': dict({
                'anyOf': list([
                  dict({
                    '$ref': '#/$defs/BetaPackagesParams',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'type': dict({
                'const': 'cloud',
                'type': 'string',
              }),
            }),
            'required': list([
              'type',
            ]),
            'type': 'object',
          }),
          'BetaLimitedNetworkParams': dict({
            'additionalProperties': False,
            'description': '''
              Limited network request params.
              <blank line>
              Fields default to null; on update, omitted fields preserve the
              existing value.
            ''',
            'properties': dict({
              'allow_mcp_servers': dict({
                'anyOf': list([
                  dict({
                    'type': 'boolean',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'allow_package_managers': dict({
                'anyOf': list([
                  dict({
                    'type': 'boolean',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'allowed_hosts': dict({
                'anyOf': list([
                  dict({
                    'items': dict({
                      'type': 'string',
                    }),
                    'type': 'array',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'type': dict({
                'const': 'limited',
                'type': 'string',
              }),
            }),
            'required': list([
              'type',
            ]),
            'type': 'object',
          }),
          'BetaPackagesParams': dict({
            'additionalProperties': False,
            'description': '''
              Specify packages (and optionally their versions) available in this environment.
              <blank line>
              When versioning, use the version semantics relevant for the package manager, e.g. for `pip` use `package==1.0.0`. You are responsible for validating the package and version exist. Unversioned installs the latest.
            ''',
            'properties': dict({
              'apt': dict({
                'anyOf': list([
                  dict({
                    'items': dict({
                      'type': 'string',
                    }),
                    'type': 'array',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'cargo': dict({
                'anyOf': list([
                  dict({
                    'items': dict({
                      'type': 'string',
                    }),
                    'type': 'array',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'gem': dict({
                'anyOf': list([
                  dict({
                    'items': dict({
                      'type': 'string',
                    }),
                    'type': 'array',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'go': dict({
                'anyOf': list([
                  dict({
                    'items': dict({
                      'type': 'string',
                    }),
                    'type': 'array',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'npm': dict({
                'anyOf': list([
                  dict({
                    'items': dict({
                      'type': 'string',
                    }),
                    'type': 'array',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'pip': dict({
                'anyOf': list([
                  dict({
                    'items': dict({
                      'type': 'string',
                    }),
                    'type': 'array',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'type': dict({
                'const': 'packages',
                'type': 'string',
              }),
            }),
            'type': 'object',
          }),
          'BetaUnrestrictedNetworkParam': dict({
            'additionalProperties': False,
            'description': 'Unrestricted network access.',
            'properties': dict({
              'type': dict({
                'const': 'unrestricted',
                'type': 'string',
              }),
            }),
            'required': list([
              'type',
            ]),
            'type': 'object',
          }),
          'EnvironmentSpec': dict({
            'additionalProperties': False,
            'description': '''
              Authoring shape for an environment YAML file.
              <blank line>
              Mirrors `anthropic.types.beta.environment_create_params.EnvironmentCreateParams`
              with `extra="forbid"` so authoring typos fail before any MA write. The SDK's
              `BetaCloudConfigParams` TypedDict is the nested type for `config` — no
              re-declaration here. `metadata` is intentionally omitted: the upload call
              synthesizes `{daimon_account, daimon_name}` at the SDK boundary.
            ''',
            'properties': dict({
              'config': dict({
                'anyOf': list([
                  dict({
