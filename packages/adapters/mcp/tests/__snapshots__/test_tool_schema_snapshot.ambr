                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'thread_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
