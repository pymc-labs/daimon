                  dict({
                    'const': 'any',
                    'type': 'string',
                  }),
                  dict({
                    'items': dict({
                      'type': 'string',
                    }),
                    'type': 'array',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
                'default': 'any',
              }),
            }),
            'type': 'object',
          }),
