    'post_github_app_install_link': dict({
      'description': '''
        Install the GitHub App: post a link inviting the user to grant repository access.
        <blank line>
        For requests to set up or hook up GitHub for an agent, use
        ``github_connect`` instead.
        Never suggest a GitHub token; existing bound tokens keep being used.
        <blank line>
        Posts a link button in this channel opening GitHub's install page. It cannot
        tell whether installation happened. Installing alone neither verifies this
        tenant's access nor binds a working repo; use ``github_connect`` and
        verify access through the requested operation afterwards.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'channel_id': dict({
            'type': 'string',
          }),
          'purpose': dict({
            'type': 'string',
          }),
        }),
        'required': list([
          'channel_id',
          'purpose',
        ]),
        'type': 'object',
      }),
    }),
    'post_wizard': dict({
      'description': '''
        Post a multi-step form in the channel instead of asking in prose.
        <blank line>
        Each entry in ``steps`` carries ``question`` (the text shown to the
        user), ``kind`` (``choice``, ``multi`` or ``text``), and ``options``
        for the two choice kinds. A step may carry one finished image by
        passing the file-store handle returned by the image-generation tool —
        never a URL, never a diagram source. Post it in a channel or thread you
        are in; where a place takes no forms or no step images, the call is refused
        and says so. A form that exceeds a limit (too many steps, too many
        options, too long a question) raises an error naming the offending
        step — split the form into a shorter follow-up and retry.
        <blank line>
        AFTER CALLING THIS TOOL YOU MUST END YOUR TURN IMMEDIATELY. Do not
        narrate the form, do not continue the conversation, and do not call
        another tool. The user's answers arrive later as a brand-new message.
      ''',
      'parameters': dict({
        '$defs': dict({
          'Option': dict({
            'description': 'One selectable option on a `choice` or `multi` step.',
            'properties': dict({
              'description': dict({
                'anyOf': list([
                  dict({
                    'type': 'string',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
                'default': None,
                'description': 'Optional secondary text shown alongside the option label.',
              }),
              'label': dict({
                'description': 'Human-readable button/select-option text shown to the user.',
                'type': 'string',
              }),
              'value': dict({
                'description': 'Stable machine value recorded in the answer when this option is chosen.',
                'type': 'string',
              }),
            }),
            'required': list([
              'label',
              'value',
            ]),
            'type': 'object',
          }),
          'Step': dict({
            'description': '''
              One screen of the wizard: a question plus how it is answered.
              <blank line>
              Accepts the shape a model actually writes as well as the canonical one.
              Authored by an LLM at a tool boundary, and the canonical field names lose
              every coin-flip against the prior set by other form APIs: `type` for
              `kind`, `title`/`label` for `question`, plain strings for `options`, and
              `single_choice`/`multi_select`/`free_text` for the enum's
              `choice`/`multi`/`text`. A real session sent exactly that, collected 28
              validation errors, retried with the same shape, and abandoned the form.
              Rejecting it was defensible per-field and useless in aggregate, so the
              aliases and coercions below absorb the difference instead.
            ''',
            'properties': dict({
              'allow_custom': dict({
                'default': True,
                'description': 'Whether the user may add a free-text option alongside the listed options.',
                'type': 'boolean',
              }),
              'image_handle': dict({
                'anyOf': list([
                  dict({
                    'type': 'string',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
                'default': None,
                'description': 'File-store handle id previously returned by the image-generation tool -- a finished PNG, never a URL and never a diagram source. Anything that produces an image does so upstream, before the handle is attached here.',
              }),
              'image_url': dict({
                'anyOf': list([
                  dict({
                    'type': 'string',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
                'default': None,
                'description': 'Server-populated; ignored when supplied by the caller.',
              }),
              'key': dict({
                'default': '',
                'description': "Stable identifier for this step's answer; must be unique across the form. Omit it and a slug of the question is used.",
                'type': 'string',
              }),
              'kind': dict({
                '$ref': '#/$defs/StepKind',
                'description': 'Whether this step is a single choice, a multi-select, or free text.',
              }),
              'max': dict({
                'anyOf': list([
                  dict({
                    'type': 'integer',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
                'default': None,
                'description': 'Maximum number of selections allowed on a `multi` step.',
              }),
              'min': dict({
                'anyOf': list([
                  dict({
                    'type': 'integer',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
                'default': None,
                'description': 'Minimum number of selections required on a `multi` step.',
              }),
              'options': dict({
                'description': 'The selectable options for a `choice` or `multi` step. Unused for `text`. A plain string is accepted and becomes both the label and the value.',
                'items': dict({
                  '$ref': '#/$defs/Option',
                }),
                'type': 'array',
              }),
              'question': dict({
                'description': 'The question text shown to the user on this step.',
                'type': 'string',
              }),
            }),
            'required': list([
              'question',
              'kind',
            ]),
            'type': 'object',
          }),
          'StepKind': dict({
            'description': 'The three step shapes a wizard form can author.',
            'enum': list([
              'choice',
              'multi',
              'text',
            ]),
            'type': 'string',
          }),
        }),
        'additionalProperties': False,
        'properties': dict({
          'channel_id': dict({
            'type': 'string',
          }),
          'prompt': dict({
            'type': 'string',
          }),
          'steps': dict({
            'items': dict({
              '$ref': '#/$defs/Step',
            }),
            'type': 'array',
          }),
        }),
        'required': list([
          'prompt',
          'steps',
          'channel_id',
        ]),
        'type': 'object',
      }),
    }),
    'publish_report': dict({
      'description': '''
        Publish a report: a page where the named people can read it and
        ask it questions.
        <blank line>
        Pass a short slug (goes in the URL), a title, one entry per
        recipient (``name`` and ``label`` — a short identifier for their
        link, e.g. an email or handle), a dollar cap on how much reader Q&A
        may spend against your tenant's balance, and optionally which agent
        should answer questions (defaults to this tenant's configured
        agent).
        <blank line>
        Pass this turn's ``origin_context_id``. An agent with a rule (where it
        runs) publishes only once the requester approves the call on a card: a
        link reaches whoever holds it. A channel's own agent never answers a
        report. When the answering agent has a rule, a non-admin may only
        publish its reader from inside its channels.
        <blank line>
        Returns ``{upload_url, links}``: ``upload_url`` is a one-time
        capability URL: ``links`` maps each recipient's name to their own
        personal link.
        <blank line>
        What to do next: build ONE gzip archive (``tar -czf bundle.tar.gz
        report.pdf analysis/``) with the report PDF at its root and the
        analysis files beside it, using relative paths only — no absolute
        paths, no leading slash — then PUT it to ``upload_url``:
        ``curl -sS -X PUT --data-binary @bundle.tar.gz "<upload_url>"``.
        Keep the archive under the size cap; if it's too large, raw model
        output files (posterior draws, large .nc/.csv dumps) are the first
        thing to drop — never the PDF or the code that produced it. Relay
        each recipient their own link; the links are not interchangeable.
      ''',
      'parameters': dict({
        '$defs': dict({
          'Recipient': dict({
            'description': 'One named recipient of a published report; the host mints one link each.',
            'properties': dict({
              'label': dict({
                'type': 'string',
              }),
              'name': dict({
                'type': 'string',
              }),
            }),
            'required': list([
              'name',
              'label',
            ]),
            'type': 'object',
          }),
        }),
        'additionalProperties': False,
        'properties': dict({
          'agent': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'cap_usd': dict({
            'anyOf': list([
              dict({
                'type': 'number',
              }),
              dict({
                'type': 'string',
              }),
            ]),
          }),
          'origin_context_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'recipients': dict({
            'items': dict({
              '$ref': '#/$defs/Recipient',
            }),
            'type': 'array',
          }),
          'slug': dict({
            'type': 'string',
          }),
          'title': dict({
            'type': 'string',
          }),
        }),
        'required': list([
          'slug',
          'title',
          'recipients',
          'cap_usd',
        ]),
        'type': 'object',
      }),
    }),
    'read_channel': dict({
      'description': '''
        Read channel messages, oldest-first, with pagination metadata.
        <blank line>
        For threads use read_thread. Pass channel_id as turn_controls or
        list_channels gives it (``parent_channel_id`` for the current channel). At
        most 200 messages per call, and a smaller page may come back; where posts
        carry replies you get up to 50 posts with their replies, ordered by latest
        activity. To read older ones, pass the result's next_cursor as cursor, or its
        next_before as before; the other parameter is rejected. A private 1:1 chat
        cannot be read back.
        <blank line>
        A channel the workspace sealed is readable only from a conversation inside
        it: pass this turn's origin_context_id when reading one. Private and shared
        channels can need it too; a refusal says so.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'before': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'channel_id': dict({
            'type': 'string',
          }),
          'cursor': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'limit': dict({
            'default': 50,
            'type': 'integer',
          }),
          'origin_context_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
        }),
        'required': list([
          'channel_id',
        ]),
        'type': 'object',
      }),
    }),
    'read_thread': dict({
      'description': '''
        Read messages from a thread, oldest-first.
        <blank line>
        Pass thread_id exactly as turn_controls, list_threads or parse_link gives
        it. Returns the root and the newest replies, at most 200 messages per call
        with the root included (fewer where a limit applies); a limit below 2 still
        reads the root and one reply. To read older ones, pass the result's
        next_cursor as cursor, or its next_before as before; the other parameter is
        rejected. Threads under a sealed channel need origin_context_id, as
        read_channel does.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'before': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'cursor': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'limit': dict({
            'default': 50,
            'type': 'integer',
          }),
          'origin_context_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'thread_id': dict({
            'type': 'string',
          }),
        }),
        'required': list([
          'thread_id',
        ]),
        'type': 'object',
      }),
    }),
    'redeem_promo_code': dict({
      'description': '''
        Redeem a promo code for credit on this workspace.
        For example, apply the code someone was given to add credit to the balance.
        <blank line>
        Case, spaces and dashes in ``code`` do not matter. Each code works once
        per workspace. Timed credit only exists between its start and
        end and is spent before other credit; whatever is left expires at the
        end. Repeated wrong codes pause redemption for a few minutes. Requires
        an admin.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'code': dict({
            'type': 'string',
          }),
        }),
        'required': list([
          'code',
        ]),
        'type': 'object',
      }),
    }),
    'remove_agent_key': dict({
      'description': '''
        Remove an old API key or token, such as a Toggl key, from an agent's stored keys.
        <blank line>
        Use ``request_agent_key`` to add a key privately and ``list_agent_keys`` to
        inspect stored names. Removing a missing key also succeeds; ``removed`` says
        whether it was present. This deletes the stored environment variable and never
        returns its secret value. Removing it stops it being supplied from the next
        message; it does not cancel it at the service or stop work already using it.
        Anyone may add a key, but removing one from an agent that answers a channel
        or the whole workspace needs an admin.
        Pass this turn's ``origin_context_id`` so its channel counts.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'agent_name': dict({
            'type': 'string',
          }),
          'expected_ma_agent_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'key': dict({
            'description': 'Stored environment variable name, UPPER_SNAKE, e.g. TOGGL_TOKEN or OPENAI_API_KEY; never the secret value.',
            'type': 'string',
          }),
          'origin_context_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
        }),
        'required': list([
          'agent_name',
          'key',
        ]),
        'type': 'object',
      }),
    }),
    'remove_channel_skill': dict({
      'description': 'Remove an extra skill from a channel, by id or name. Admin-only.',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'channel_id': dict({
            'type': 'string',
          }),
          'skill': dict({
            'type': 'string',
          }),
        }),
        'required': list([
          'channel_id',
          'skill',
        ]),
        'type': 'object',
      }),
    }),
    'remove_repo': dict({
      'description': '''
        Remove owner/repo from this agent only.
        <blank line>
        A clear ask is enough: call it right away and reply with the returned
        line. Ask only if the repo or agent is unclear. confirmed is ignored.
        The Connect GitHub page also adds and removes repos. If it was the working
        repo, the working repo is cleared. Other agents keep their access.
        Pass the current turn origin and selected agent identity.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'agent_name': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'confirmed': dict({
            'default': False,
            'type': 'boolean',
          }),
          'expected_ma_agent_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'origin_context_id': dict({
            'default': '',
            'type': 'string',
          }),
          'repo_name': dict({
            'type': 'string',
          }),
        }),
        'required': list([
          'repo_name',
        ]),
        'type': 'object',
      }),
