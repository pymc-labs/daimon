                'type': 'string',
              }),
              'permission_policy': dict({
                'anyOf': list([
                  dict({
                    '$ref': '#/$defs/BetaManagedAgentsAlwaysAllowPolicyParam',
                  }),
                  dict({
                    '$ref': '#/$defs/BetaManagedAgentsAlwaysAskPolicyParam',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
            }),
            'required': list([
              'name',
            ]),
            'type': 'object',
          }),
          'BetaManagedAgentsAgentToolset20260401Params': dict({
            'description': '''
              Configuration for built-in agent tools.
              <blank line>
              Use this to enable or disable groups of tools available to the agent.
