              'deal_id': dict({
                'anyOf': list([
                  dict({
                    'maxLength': 20,
                    'pattern': '^\\d+$',
                    'type': 'string',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
                'default': None,
              }),
              'discord_message_id': dict({
                'anyOf': list([
                  dict({
                    'maxLength': 20,
                    'pattern': '^\\d+$',
                    'type': 'string',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
                'default': None,
              }),
              'discord_post_absence_confirmed': dict({
                'default': False,
                'type': 'boolean',
              }),
              'evidence': dict({
                'maxLength': 2000,
                'minLength': 20,
                'type': 'string',
              }),
              'separate_opportunity_confirmed': dict({
                'default': False,
                'type': 'boolean',
              }),
            }),
            'required': list([
              'evidence',
            ]),
            'type': 'object',
          }),
        }),
        'additionalProperties': False,
        'properties': dict({
          'intake_id': dict({
            'format': 'uuid',
            'type': 'string',
          }),
          'resolution': dict({
            '$ref': '#/$defs/IntakeResolution',
          }),
        }),
        'required': list([
          'intake_id',
          'resolution',
        ]),
        'type': 'object',
      }),
    }),
    'lead_intake_resume': dict({
