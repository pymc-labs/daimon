    'update_environment': dict({
      'description': 'Patch-update an environment. Omitted (None) fields are preserved.',
      'parameters': dict({
        '$defs': dict({
          'BetaCloudConfigParams': dict({
            'description': '''
              Request params for `cloud` environment configuration.
              
              Fields default to null; on update, omitted fields preserve the
              existing value.
            ''',
            'properties': dict({
              'networking': dict({
                'anyOf': list([
                  dict({
                    '$ref': '#/$defs/BetaUnrestrictedNetworkParam',
                  }),
