                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'origin_context_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
