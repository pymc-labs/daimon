            'type': 'string',
          }),
          'repo_url': dict({
            'type': 'string',
          }),
          'service': dict({
            'const': 'github',
            'default': 'github',
            'type': 'string',
          }),
        }),
        'required': list([
          'repo_url',
          'default_branch',
        ]),
        'type': 'object',
      }),
    }),
    'skills_delete': dict({
