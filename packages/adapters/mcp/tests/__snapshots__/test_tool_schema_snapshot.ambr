    'get_routine': dict({
      'description': 'Get a routine by id (tenant-scoped; raises if not found or cross-tenant).',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'routine_id': dict({
            'format': 'uuid',
            'type': 'string',
          }),
        }),
        'required': list([
          'routine_id',
        ]),
        'type': 'object',
      }),
