              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'content': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'has': dict({
            'anyOf': list([
              dict({
                'items': dict({
                  'type': 'string',
                }),
                'type': 'array',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'limit': dict({
            'default': 25,
            'type': 'integer',
          }),
          'mentions': dict({
            'anyOf': list([
              dict({
                'items': dict({
                  'type': 'string',
                }),
                'type': 'array',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
