                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'revoke': dict({
            'default': False,
            'type': 'boolean',
          }),
        }),
        'required': list([
          'agent_name',
        ]),
        'type': 'object',
      }),
