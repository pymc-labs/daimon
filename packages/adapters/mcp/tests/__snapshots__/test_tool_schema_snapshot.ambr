        'required': list([
          'channel_id',
        ]),
        'type': 'object',
      }),
    }),
    'clear_channel_budget': dict({
      'description': '''
        Remove a channel's spending budget, so only the balance and caps apply. Admin-only.
        
        A thread id clears its parent channel's budget.
