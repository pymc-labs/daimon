                'type': 'string',
              }),
              'type': dict({
                'const': 'custom',
                'type': 'string',
              }),
              'version': dict({
                'anyOf': list([
                  dict({
                    'type': 'string',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
            }),
            'required': list([
              'skill_id',
              'type',
            ]),
            'type': 'object',
          }),
          'BetaManagedAgentsCustomToolInputSchemaParam': dict({
            'additionalProperties': True,
            'description': 'JSON Schema for custom tool input parameters.',
            'properties': dict({
              'properties': dict({
                'anyOf': list([
                  dict({
                    'additionalProperties': True,
                    'type': 'object',
                  }),
