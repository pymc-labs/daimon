          'name': dict({
            'type': 'string',
          }),
          'skills': dict({
            'anyOf': list([
              dict({
                'items': dict({
                  'anyOf': list([
                    dict({
                      'type': 'string',
                    }),
                    dict({
                      '$ref': '#/$defs/BetaManagedAgentsAnthropicSkillParams',
                    }),
                    dict({
