                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'type': dict({
                'const': 'cloud',
                'type': 'string',
              }),
            }),
            'required': list([
              'type',
            ]),
            'type': 'object',
          }),
          'BetaLimitedNetworkParams': dict({
            'description': '''
              Limited network request params.
              
              Fields default to null; on update, omitted fields preserve the
              existing value.
            ''',
