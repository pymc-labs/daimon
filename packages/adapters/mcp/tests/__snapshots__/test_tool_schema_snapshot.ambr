      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'agent_id': dict({
            'type': 'string',
          }),
          'origin_context_id': dict({
            'type': 'string',
          }),
        }),
        'required': list([
          'origin_context_id',
          'agent_id',
        ]),
        'type': 'object',
      }),
