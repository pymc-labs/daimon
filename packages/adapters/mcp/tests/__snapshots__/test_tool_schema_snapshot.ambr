        'parameters': dict({
          'additionalProperties': False,
          'properties': dict({
            'daimon_id': dict({
              'type': 'string',
            }),
            'message': dict({
              'type': 'string',
            }),
          }),
          'required': list([
            'daimon_id',
            'message',
          ]),
          'type': 'object',
        }),
      }),
    }),
  })
