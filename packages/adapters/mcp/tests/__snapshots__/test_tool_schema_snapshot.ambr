        ]),
        'type': 'object',
      }),
    }),
    'convert': dict({
      'description': '''
        Convert an ISO-8601 ``time`` from ``from_tz`` to ``to_tz``.
        <blank line>
        Naive input is interpreted as ``from_tz``; aware input must agree
        with ``from_tz`` at that wall time.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'from_tz': dict({
            'type': 'string',
          }),
          'time': dict({
            'type': 'string',
          }),
