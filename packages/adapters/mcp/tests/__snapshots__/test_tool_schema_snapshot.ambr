        'required': list([
          'agent_name',
        ]),
        'type': 'object',
      }),
    }),
    'set_agent_rule': dict({
      'description': '''
        Set where an agent runs: only in the ``runs_in`` channels and their threads,
        or, with null, wherever it is set to answer; an empty list runs it nowhere.
        Requires an admin.
        <blank line>
        Outside its rule its turns are refused. An agent with a rule messages only
        whoever asked, asks before publishing, and can't be copied. A channel's own
        agent keeps its rule until that channel's readers change (``set_channel_rule``).
        Naming a channel only its own agents read makes the agent one of them, so name
        that channel alone.
      ''',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'agent_name': dict({
            'type': 'string',
          }),
          'runs_in': dict({
            'anyOf': list([
              dict({
                'items': dict({
                  'type': 'string',
                }),
                'type': 'array',
              }),
              dict({
                'type': 'null',
              }),
            ]),
          }),
        }),
        'required': list([
          'agent_name',
          'runs_in',
        ]),
        'type': 'object',
      }),
    }),
    'set_agent_tool_rule': dict({
      'description': "Set one agent's tool rule.",
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'agent_name': dict({
            'type': 'string',
          }),
          'channel_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'rule': dict({
            'enum': list([
              'allow',
              'ask',
              'deny',
            ]),
            'type': 'string',
          }),
          'scope': dict({
            'default': 'chat',
            'enum': list([
              'chat',
              'chat_and_routines',
