                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'expected_ma_agent_id': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
          }),
          'origin_context_id': dict({
            'default': '',
            'type': 'string',
          }),
          'repo_name': dict({
            'type': 'string',
          }),
