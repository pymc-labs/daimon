              'enabled': dict({
                'anyOf': list([
                  dict({
                    'type': 'boolean',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'permission_policy': dict({
                'anyOf': list([
                  dict({
                    '$ref': '#/$defs/BetaManagedAgentsAlwaysAllowPolicyParam',
                  }),
                  dict({
                    '$ref': '#/$defs/BetaManagedAgentsAlwaysAskPolicyParam',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
            }),
            'type': 'object',
          }),
          'BetaManagedAgentsMCPToolsetParams': dict({
            'description': 'Configuration for tools from an MCP server defined in `mcp_servers`.',
            'properties': dict({
              'configs': dict({
                'items': dict({
                  '$ref': '#/$defs/BetaManagedAgentsMCPToolConfigParams',
                }),
                'type': 'array',
              }),
              'default_config': dict({
                'anyOf': list([
                  dict({
                    '$ref': '#/$defs/BetaManagedAgentsMCPToolsetDefaultConfigParams',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
              'mcp_server_name': dict({
                'type': 'string',
              }),
              'type': dict({
                'const': 'mcp_toolset',
                'type': 'string',
              }),
            }),
            'required': list([
              'mcp_server_name',
              'type',
            ]),
            'type': 'object',
          }),
          'BetaManagedAgentsURLMCPServerParams': dict({
