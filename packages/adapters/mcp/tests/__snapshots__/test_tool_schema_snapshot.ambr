    'self_list_files': dict({
      'description': 'List all keys + metadata for files in your private agent_files namespace.',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
        }),
        'type': 'object',
      }),
    }),
    'self_read_file': dict({
      'description': 'Read a per-agent file by `key`. Returns null if no file exists at that key.',
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
          'key': dict({
            'type': 'string',
          }),
        }),
        'required': list([
          'key',
        ]),
        'type': 'object',
      }),
