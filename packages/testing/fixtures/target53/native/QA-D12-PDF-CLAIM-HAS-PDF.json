    "title": "when the answer says a PDF is attached, the PDF is attached and no working file leaks",
    "friction": [
      "F3",
      "D28"
    ],
    "set": "A",
    "surface": "discord",
    "tier": "full",
    "priority": "P1",
    "est_turns": 1,
    "setup": [],
    "steps": [
      {
        "do": "new_channel"
      },
      {
        "do": "mention",
        "text": "Make a one-page PDF titled 'QA PDF {nonce}' with one sentence of body text and attach it to your answer. Keep the answer to one line."
      },
      {
        "do": "wait_done",
        "timeout_s": 240
      }
    ],
    "assert": [
