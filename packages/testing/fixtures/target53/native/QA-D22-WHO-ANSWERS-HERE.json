        "turn": 1,
        "pattern": "(?i)default agent in this workspace"
      },
      {
        "kind": "text_present",
        "turn": 2,
        "pattern": "QA-SEED-{nonce}"
      },
      {
        "kind": "text_absent",
        "turn": 2,
