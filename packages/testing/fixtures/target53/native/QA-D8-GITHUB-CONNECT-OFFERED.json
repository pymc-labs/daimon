    "id": "QA-D8-GITHUB-CONNECT-OFFERED",
    "title": "asking to connect GitHub on a fork with no saved key offers the Connect button, not 'ask your operator'",
    "friction": [
      "D13",
      "F7"
    ],
    "set": "A",
    "surface": "discord",
    "tier": "weekly",
    "priority": "P1",
    "est_turns": 1,
    "notes": "The saved-key variant (the actual D8 refusal) needs a repo-card modal submit: see QA-D8-GITHUB-SAVED-KEY-SWITCH (B).",
