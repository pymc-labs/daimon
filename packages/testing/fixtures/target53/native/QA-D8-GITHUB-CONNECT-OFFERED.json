    "steps": [
      {
        "do": "new_channel"
      },
      {
        "do": "admin",
        "tool": "cli",
        "args": "daimon channels rule set discord {guild_id} {channel_id} --readers own --copy-from daimon"
      },
      {
        "do": "mention",
        "as": "admin",
        "text": "Connect GitHub for this channel's agent."
      },
      {
        "do": "wait_done"
      }
    ],
    "assert": [
