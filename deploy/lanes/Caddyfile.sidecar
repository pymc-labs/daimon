{
    auto_https disable_redirects
}

(ingress) {
    reverse_proxy sidecar:8780 {
        transport http {
            dial_timeout 2s
            response_header_timeout 12s
        }
    }
}

{$DAIMON_SIDECAR_PUBLIC_HOST} {
    @signed {
        method POST
        path_regexp ^/callbacks/watches/[0-9a-fA-F-]{36}$
    }
    @token {
        method POST
        path_regexp ^/callbacks/watches/[0-9a-fA-F-]{36}/[A-Za-z0-9_-]{16,128}$
    }
    handle @signed {
        request_body {
            max_size 4KiB
        }
        import ingress
    }
    handle @token {
        request_body {
            max_size {$DAIMON_WATCHES__CALLBACK_MAX_BODY_BYTES:4096}
        }
        import ingress
    }
    handle {
        respond 404
    }
}
