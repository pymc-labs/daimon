{
    auto_https disable_redirects
}

{$DAIMON_SIDECAR_PUBLIC_HOST} {
    @callback {
        method POST
        path_regexp callback ^/callbacks/watches/[0-9a-fA-F-]{36}$
    }
    handle @callback {
        request_body {
            max_size 4KiB
        }
        reverse_proxy sidecar:8780 {
            transport http {
                dial_timeout 2s
                response_header_timeout 12s
            }
        }
    }
    handle {
        respond 404
    }
}
