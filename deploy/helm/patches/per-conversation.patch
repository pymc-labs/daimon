diff --git a/deploy/helm/daimon-selfhost/values.yaml b/deploy/helm/daimon-selfhost/values.yaml
index 86b1843..5424df1 100644
--- a/deploy/helm/daimon-selfhost/values.yaml
+++ b/deploy/helm/daimon-selfhost/values.yaml
@@ -39,6 +39,24 @@ host:
     requests: {cpu: 50m, memory: 256Mi}
     limits: {memory: 1536Mi}
 harness:
+  mode: shared
+  perConversation:
