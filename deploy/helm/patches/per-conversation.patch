diff --git a/deploy/helm/daimon-selfhost/templates/mcp-tls.yaml b/deploy/helm/daimon-selfhost/templates/mcp-tls.yaml
index 1815a4b..1852799 100644
--- a/deploy/helm/daimon-selfhost/templates/mcp-tls.yaml
+++ b/deploy/helm/daimon-selfhost/templates/mcp-tls.yaml
@@ -24,4 +24,27 @@ metadata:
   name: {{ $name }}
 type: kubernetes.io/tls
 data: {{ $data | toJson }}
+{{- if and .Values.harness.enabled (eq .Values.harness.mode "perConversation") }}
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: {{ include "d.name" . }}-harness-public-ca
+  namespace: {{ default (printf "%s-sandboxes" .Release.Name) .Values.harness.perConversation.sandboxNamespace }}
+data:
+  ca.crt: {{ index $data "ca.crt" | b64dec | quote }}
+{{- end }}
+{{- end }}
+
+{{- if and .Values.mcpTLS.existingSecret .Values.harness.enabled (eq .Values.harness.mode "perConversation") }}
+{{- $external := lookup "v1" "Secret" .Release.Namespace .Values.mcpTLS.existingSecret }}
+{{- if not $external }}{{ fail "perConversation requires existingSecret to be available for public CA projection" }}{{ end }}
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: {{ include "d.name" . }}-harness-public-ca
+  namespace: {{ default (printf "%s-sandboxes" .Release.Name) .Values.harness.perConversation.sandboxNamespace }}
+data:
+  ca.crt: {{ required "existingSecret requires ca.crt" (index $external.data "ca.crt") | b64dec | quote }}
 {{- end }}
