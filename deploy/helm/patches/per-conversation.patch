@@ -33,6 +33,19 @@ host:
     requests: {cpu: 50m, memory: 256Mi}
     limits: {memory: 1536Mi}
 harness:
+  mode: shared
+  perConversation:
+    # Accepted risk F76: C3 HTTP only within the controller/sandbox policy boundary.
+    allowInsecureHTTP: false
+    # Required for bundled HTTPS MCP; CA Secret must contain only/public ca.crt.
+    mcpCASecret: ""
+    warmPool: 1
+    controllerResources:
+      requests: {cpu: 50m, memory: 128Mi}
+      limits: {cpu: 500m, memory: 384Mi}
+    sandboxResources:
+      requests: {cpu: 100m, memory: 256Mi}
+      limits: {cpu: 750m, memory: 768Mi}
   enabled: true
   # F72: router and pod-per-session are future work. Only multi is implemented.
   sessions: {mode: multi}
