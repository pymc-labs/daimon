# === Required ===
# Postgres connection string used by the running application (SQLAlchemy async + asyncpg). Required.
DAIMON_DATABASE__URL=postgresql+asyncpg://daimon:daimon@localhost:5432/daimon

# === Core (optional) ===
# Security audit retention age in days, default 90. Operators must schedule `daimon audit prune TENANT_UUID` for each tenant (for example daily). The command deletes older events. Set 0 to explicitly retain events forever; privacy erasure and tenant deletion still apply.
# DAIMON_SECURITY_AUDIT_RETENTION_DAYS=90
# Per-tenant completion notification policy, keyed by tenant UUID. Discord and Slack acknowledge mentions independently of this setting and clear the acknowledgment when the turn settles. True adds a success check mark and posts the final answer as a fresh reply mentioning only the requester on Discord and Slack. On Teams it closes the status card and posts the answer fresh, mentioning the requester in channels (Teams bots cannot react). Missing/false preserves in-place delivery. Configure DAIMON_COMPLETION_PINGS as a JSON object.
# DAIMON_COMPLETION_PINGS={}
# Per-tenant switch for the channel budget notice, keyed by tenant UUID. When a channel's budget is used up, the server admins get one DM per budget window on Discord, Slack and Teams. Missing/true sends it; false turns it off. Configure DAIMON_BUDGET_NOTICES as a JSON object.
# DAIMON_BUDGET_NOTICES={}
# Per-tenant DM recipient policies keyed by tenant UUID (normalized at load; invalid keys rejected). Default is members (live membership required). Set mode=disabled to disable DMs, or mode=allowlist with recipient_ids to restrict delivery to listed members. Configure DAIMON_DIRECT_MESSAGE_POLICIES as a JSON object.
# DAIMON_DIRECT_MESSAGE_POLICIES={}
# Per-tenant table rendering, keyed by tenant UUID. Discord renders final Markdown tables as PNG unless the tenant is set to false. Slack renders native tables only when set to true. Set DAIMON_TABLE_RENDERING to a JSON object.
# DAIMON_TABLE_RENDERING={}
# URL rendered on the privacy panels' Policy button. Override via DAIMON_PRIVACY_POLICY_URL if you host your own policy page.
# DAIMON_PRIVACY_POLICY_URL=https://github.com/pymc-labs/daimon/blob/main/PRIVACY.md
# Filesystem path to the seeded defaults/ directory consumed by daimon.core.defaults.apply.apply_defaults. Default Path('defaults') is relative to the process cwd — works for in-repo dev (repo root) and the deployed container layout (working dir contains defaults/ at root). Single source of truth shared by the scheduler, Discord/Slack adapters, CLI session bootstrap, and MCP routine tools. Do NOT add adapter-local defaults_root fields — they invite drift.
# DAIMON_DEFAULTS_ROOT=defaults

# === Database (optional) ===
# Postgres connection string for the test suite. Points at a dedicated database (e.g. daimon_test) so test runs never touch development data. Unset in production.
# DAIMON_DATABASE__TEST_URL=
# Persistent Postgres connections per process. Default 5; size against all application processes and the database connection limit.
# DAIMON_DATABASE__POOL_SIZE=5
# Temporary Postgres connections above pool_size per process. Default 10; include these in the database connection budget. pool_size + max_overflow must be at least 4; smaller pools are rejected at engine startup to reserve independent preparation and mutation capacity with nested query headroom. Fence contenders release connections and permits between nonblocking attempts, retrying with 25-75 ms jitter for at most 5 seconds before retryable session busy.
# DAIMON_DATABASE__MAX_OVERFLOW=10
# Seconds to wait for a free Postgres connection before failing. Default 30 seconds.
# DAIMON_DATABASE__POOL_TIMEOUT=30.0
# Maximum concurrent session preparations holding a Postgres advisory-lock transaction per process. Unset uses half of pool_size (at least one), leaving connections for preparation's nested queries and turn outcomes. Keep this below pool_size so nested queries have headroom. Excess preparations wait in memory instead of timing out in the DB pool.
# DAIMON_DATABASE__PREPARATION_CONCURRENCY=

# === Anthropic (optional) ===
# Anthropic API key used to authenticate all Managed Agents SDK calls. Required unless this deployment is OpenAI-only (see docs/self-hosting.md's 'Self-host on OpenAI'), in which case leave it unset. (secret)
# DAIMON_ANTHROPIC__API_KEY=
# Base URL for the Anthropic API. Override only when routing through a proxy or a non-default API endpoint.
# DAIMON_ANTHROPIC__BASE_URL=https://api.anthropic.com
# Maximum Anthropic Skills API requests per minute in this process. Default 80 leaves headroom below the 100 requests/minute organization limit. Other deployments in the same organization share that limit.
# DAIMON_ANTHROPIC__SKILLS_REQUESTS_PER_MINUTE=80

# === Privacy (optional) ===
# Show account deletion in Discord, Slack, and Teams privacy panels and allow delete confirmations. Set DAIMON_PRIVACY__DELETE_ENABLED=false to pause deletion during an event; Policy and Export remain available.
# DAIMON_PRIVACY__DELETE_ENABLED=True

# === CLI (optional) ===
# Display name used to identify the local operator running the CLI. Defaults to the $USER environment variable, falling back to 'daimon' when unset. (defaults to $USER)
# DAIMON_CLI__LOCAL_USER=

# === Logging (optional) ===
# Minimum log level emitted by the structured logger.
# DAIMON_LOG__LEVEL=INFO

# === Observability (optional) ===
# Seconds between runtime.health structured log lines from each long-running process. Default 30; set DAIMON_OBSERVABILITY__HEALTH_INTERVAL_S=0 to disable.
# DAIMON_OBSERVABILITY__HEALTH_INTERVAL_S=30

# === Ops (optional) ===
# Discord webhook URL for short operator alerts about new installs, Stripe top-ups, and Anthropic limits. Unset disables alerts. Keep the URL secret. (secret)
# DAIMON_OPS__ALERT_WEBHOOK_URL=

# === MCP Server (optional) ===
# Secret used to sign and verify MCP bearer tokens. Required to run the MCP adapter. (required to run the MCP adapter; secret)
# DAIMON_MCP__JWT_SECRET=
# UTC deadline for a temporary legacy-token deployment window. Dates before 2026-10-16 or over six hours in the future are refused. At/after the deadline all unregistered tokens are rejected, regardless of issuance time. Internal tokens are always rejected without a registry row.
# DAIMON_MCP__LEGACY_TOKEN_CUTOFF=
# Temporary minters-first deployment compatibility only. Requires a bounded legacy_token_cutoff; only non-internal legacy tokens qualify and stop working at that deadline even if the deployment is interrupted. Default false requires registered tokens immediately.
# DAIMON_MCP__ALLOW_LEGACY_TOKENS=False
# Require an explicit destination when the MCP create_routine tool is called. When enabled, a missing destination is refused before agent lookup or creation, with a warning that the routine would not post. Default false preserves record-only routines; existing routines and updates are unaffected.
# DAIMON_MCP__REQUIRE_ROUTINE_DESTINATION=False
# Externally reachable base URL of the MCP server (the streamable endpoint, e.g. https://mcp.example.com/mcp). Required to run the MCP adapter — used to build OAuth/CLI/health route URLs and session-create metadata. (required to run the MCP adapter)
# DAIMON_MCP__PUBLIC_URL=
# On-disk directory for the media-tool FileStore. When unset, the server uses tempfile.gettempdir() / 'daimon-mcp-files' resolved at startup.
# DAIMON_MCP__FILE_STORE_DIR=
# Per-upload byte cap enforced by the bundle upload route. The default keeps headroom under a 32 MiB proxy request limit; raise it if the front end in front of the mcp service allows larger bodies.
# DAIMON_MCP__BUNDLE_MAX_BYTES=26214400
# Per-token cap on bundle upload route calls per rolling hour. Prevents a compromised or buggy caller from exhausting the Files API upload path. Set to 0 to disable (not recommended in production).
# DAIMON_MCP__BUNDLE_UPLOADS_PER_HOUR=20
# How long an uploaded bundle object is retained on the Files API before deletion. Deletion is performed by the scheduler's pending-file sweeper, not by this process directly — a deployment running no scheduler will never reclaim these objects.
# DAIMON_MCP__BUNDLE_TTL_DAYS=90
# Per-token cap on tool calls an operator token (minted with `daimon mcp mint-operator-token`) may make per rolling minute, counted in each MCP process. Set to 0 to disable.
# DAIMON_MCP__OPERATOR_CALLS_PER_MINUTE=60

# === MCP OAuth (optional) ===
# OAuth clients registered by hand, for authorization servers that offer no dynamic client registration. A JSON array; each entry has authorization_server_host (the bare host of the authorization server), mcp_servers (required: the exact https URLs of the MCP servers this client may be used for), client_id, client_secret, token_endpoint_auth_method (client_secret_post by default, or client_secret_basic), optional authorization_endpoint and token_endpoint overrides (public https), optional scope (space-separated; replaces the scopes the MCP server publishes) and send_resource (default true; false leaves the RFC 8707 resource parameter out of sign-in and refresh). A sign-in uses an entry only when its MCP server is listed and its authorization server is on that host; it then also asks for offline_access when the authorization server offers it. Every other sign-in registers a client dynamically. Default: [] (always register).
# DAIMON_MCP_OAUTH__CLIENTS=[]

# === Hub (optional) ===
# Slack OAuth app client ID for the /slack/mcp login mount. Register <DAIMON_MCP__PUBLIC_URL origin>/slack/auth/callback as a redirect URL on the Slack app.
# DAIMON_HUB__SLACK_CLIENT_ID=
# Slack OAuth app client secret for the /slack/mcp login mount. (secret)
# DAIMON_HUB__SLACK_CLIENT_SECRET=
# Discord OAuth app client ID for the /discord/mcp login mount. Register <DAIMON_MCP__PUBLIC_URL origin>/discord/auth/callback as a redirect URI on the Discord app.
# DAIMON_HUB__DISCORD_CLIENT_ID=
# Discord OAuth app client secret for the /discord/mcp login mount. (secret)
# DAIMON_HUB__DISCORD_CLIENT_SECRET=
# Redirect URI patterns an MCP client may register with the hub login mounts (wildcards allowed). Defaults cover coding agents on loopback and claude.ai; widen only for a client you operate.
# DAIMON_HUB__ALLOWED_CLIENT_REDIRECT_URIS=['http://localhost:*', 'http://127.0.0.1:*', 'https://claude.ai/*', 'https://claude.com/*']
# Base64url 32-byte key that signs hub login tokens. Required when any hub mount is configured, and rejected at boot unless it decodes to exactly 32 bytes. Generate with Fernet.generate_key(). (secret)
# DAIMON_HUB__JWT_SIGNING_KEY=

# === Agent Identity (optional) ===
# Enable per-agent display names and avatars on Slack and Discord, agent name prefixes on Teams, and reply-to-agent routing on Discord. Off by default; set DAIMON_AGENT_IDENTITY__ENABLED=true after platform setup is ready.
# DAIMON_AGENT_IDENTITY__ENABLED=False
# Discord guild IDs where agent identity stays off when enabled globally. Set DAIMON_AGENT_IDENTITY__EXCLUDED_DISCORD_GUILD_IDS to a JSON array of IDs. Default: [] (no guilds excluded).
# DAIMON_AGENT_IDENTITY__EXCLUDED_DISCORD_GUILD_IDS=[]
# Slack workspace team IDs where agent identity stays off when enabled globally. Set DAIMON_AGENT_IDENTITY__EXCLUDED_SLACK_TEAM_IDS to a JSON array of IDs. Default: [] (no workspaces excluded).
# DAIMON_AGENT_IDENTITY__EXCLUDED_SLACK_TEAM_IDS=[]

# === Environment (optional) ===
# Deployment name. Empty selects production Discord command behavior.
# DAIMON_ENVIRONMENT__NAME=
# Environment chip text on MCP web pages, such as Staging. Empty falls back to the deployment name; both empty shows no chip. Does not affect Discord command sync.
# DAIMON_ENVIRONMENT__LABEL=

# === Discord (optional) ===
# Discord bot token. Required to run the Discord adapter. (required to run the Discord adapter; secret)
# DAIMON_DISCORD__BOT_TOKEN=
# Guilds allowed to receive commands and events when the environment name is set. An empty list disables all Discord ingress, including DMs, in non-production.
# DAIMON_DISCORD__COMMAND_GUILD_IDS=[]
# Recent Discord activity window in minutes scanned on startup for missed mentions and replies. Set 0 to disable catch-up.
# DAIMON_DISCORD__STARTUP_REPLAY_MINUTES=0
# Maximum recently active Discord channels and threads scanned per guild on startup.
# DAIMON_DISCORD__STARTUP_REPLAY_CHANNELS_PER_GUILD=25
# Maximum recent Discord messages scanned per channel or thread on startup. Current message gates and durable admissions prevent duplicate turns.
# DAIMON_DISCORD__STARTUP_REPLAY_MESSAGES_PER_CHANNEL=100
# Opt in to one stop reaction on an explicit bot mention refused by a confirmed writers=none rule. Only the posting owner reacts, with per-requester, channel and bot-wide cooldowns. No text, DM or agent turn is sent. Unknown protection stays silent. Limits are process-local and reset on restart.
# DAIMON_DISCORD__WRITERS_NONE_NOTICE=False
# Automatically retire expired, unclicked credential cards in place. Requires the existing single-posting-process wake poller switch. Default false starts no expiry task and adds no database or Discord calls. Failed card edits remain pending for retry; no credentials or waiting work are applied.
# DAIMON_DISCORD__CREDENTIAL_FORM_EXPIRY=False
# Seconds after an admitted opening mention before reacting to it to show that its Discord thread is still opening. Includes thread naming and Discord rate-limit waits. Set to 0 to react immediately. The reaction is removed when creation finishes; a failed creation is answered with a visible error reply.
# DAIMON_DISCORD__THREAD_OPEN_NOTICE_AFTER_S=3.0
# React with 🔔 to a person's reply that does not @mention the bot in a thread the bot opened, as a hint that only mentions start a turn. The message itself is never answered. At most once per thread per unmentioned_reply_hint_cooldown_h, never on a message that mentions someone else, never to any bot, never where the agent may not post, and never while the thread is followed (thread participation on). Off by default: the cooldown is kept in memory, so each restart allows one more hint per thread.
# DAIMON_DISCORD__UNMENTIONED_REPLY_HINT=False
# Hours before the unmentioned-reply hint may be shown again in the same thread. Kept in memory, so a restart allows one more.
# DAIMON_DISCORD__UNMENTIONED_REPLY_HINT_COOLDOWN_H=24.0
# Minutes before the same person is told again that Daimon can't reply in a channel whose Who can post rule is Nobody. Their mention gets a 🔒 reaction and a direct message naming the rule and who can change it; nothing else is posted and no turn runs. Kept in memory per person and channel, so a restart allows one more.
# DAIMON_DISCORD__PROTECTED_CHANNEL_NOTICE_COOLDOWN_MIN=10.0
# Maximum number of agent turns a single tenant (Discord guild) may have in flight at once. Caps one noisy guild from starving others on the shared Anthropic key.
# DAIMON_DISCORD__MAX_CONCURRENT_TURNS_PER_TENANT=3
# Opt in to queue wording on the existing initial Discord mention card while its admitted turn waits behind the tenant concurrency cap. The same card returns to ordinary progress when the turn starts. Admission, Stop and queue limits are unchanged; no other tenant information is displayed.
# DAIMON_DISCORD__TENANT_CAP_WAITING_CARD=False
# Maximum Discord agent turns running across all guilds and DMs in this process. Unset leaves deployment-wide admission unlimited. Excess turns wait in the turn queue (see turn_queue); continuation wakes keep their existing admission path.
# DAIMON_DISCORD__MAX_CONCURRENT_TURNS=
# Minimum age in seconds before Discord can retire a card after definite recovery failure or repeated failed recovery passes. Must be at least the turn ceiling plus 15 minutes. Recovery runs at startup and periodically, and deletes a known pending card when the bot has Manage Messages permission.
# DAIMON_DISCORD__TURN_CARD_UNRECOVERABLE_AFTER_S=86400
# Failed Discord card recovery passes required before an aged intent can be retired without a definite platform failure. Count persists across restarts.
# DAIMON_DISCORD__TURN_CARD_UNRECOVERABLE_AFTER_ATTEMPTS=3
# Port for the Discord process's liveness endpoint. Must not collide with the mcp process (8080) or the scheduler process (8082) — all process groups share one host.
# DAIMON_DISCORD__HEALTH_PORT=8081
# Discord user ids of automated QA bots allowed to start turns by mention or reply to a recorded agent post. Bot-authored messages are rejected by default; these are allow-listed so a harness can drive addressed turns end-to-end without a human. Several are supported because admin-gated tools need a caller holding Manage Server while the refusal paths need one without it. Leave empty outside test deployments -- an allow-listed bot spends real credit. As a tuple field this must be set as a JSON array, e.g. '["123","456"]'. Daimon's own id is refused at the gate even if listed.
# DAIMON_DISCORD__QA_BOT_USER_IDS=
# The bot's presented name across user-facing Discord render sites (@mentions, setup messages, help text, privacy panel copy). Defaults to 'daimon' so unset deployments render byte-identical output. Set to a distinct name (e.g. 'daimon-staging') so a non-production deployment is visibly distinct in-channel.
# DAIMON_DISCORD__BOT_DISPLAY_NAME=daimon

# === Thread Participation (optional) ===
# Deployment default for replying in threads unprompted. off: mention-only until a thread, channel or workspace is turned on. disabled: mention-only and cannot be turned on. on: follow every thread unless turned off below.
# DAIMON_THREAD_PARTICIPATION__MODE=off
# How long a followed thread must be quiet after an unprompted message before the agent decides whether to reply. A burst of messages is judged once, at the end.
# DAIMON_THREAD_PARTICIPATION__QUIET_SECONDS=8.0
# Backstop: maximum unprompted replies per thread per rolling hour.
# DAIMON_THREAD_PARTICIPATION__MAX_PER_HOUR=20
# How many earlier thread messages the classifier sees before deciding.
# DAIMON_THREAD_PARTICIPATION__RECENT_MESSAGES_WINDOW=10
# Model that decides whether a burst of unprompted messages deserves a reply. One short call per quiet burst; a small, fast model is the point. The call sets effort low, so pick a model that supports the effort parameter.
# DAIMON_THREAD_PARTICIPATION__CLASSIFIER_MODEL=claude-haiku-5-5

# === Progress Plans (optional) ===
# Deployment default for progress plans on the "Working on it…" card (Discord, Slack and Teams). On, the agent keeps a short checklist of a longer task's steps on the card and may add one-line updates on what it found and does next. off: shown only where a workspace, channel or thread is turned on. disabled: never shown, and cannot be turned on. on: shown everywhere unless turned off below.
# DAIMON_PROGRESS_PLANS__MODE=off

# === Slack (optional) ===
# The bot's presented name in Slack setup, help, and privacy messages.
# DAIMON_SLACK__BOT_DISPLAY_NAME=daimon
# Slack request-signing secret used to verify inbound HTTP requests. Required — keeps the whole Slack block None when no DAIMON_SLACK__* vars are set. (required to run the Slack adapter; secret)
# DAIMON_SLACK__SIGNING_SECRET=
# Slack app-level token (xapp-...) used to open the Socket Mode connection. (required to run the Slack adapter; secret)
# DAIMON_SLACK__APP_TOKEN=
# Slack OAuth app client ID, used during the 'Add to Slack' install flow.
# DAIMON_SLACK__CLIENT_ID=
# Slack OAuth app client secret, used during the 'Add to Slack' install flow. (secret)
# DAIMON_SLACK__CLIENT_SECRET=
# Maximum number of agent turns a single tenant (Slack workspace) may have in flight at once. Caps one noisy workspace from starving others on the shared Anthropic key.
# DAIMON_SLACK__MAX_CONCURRENT_TURNS_PER_TENANT=3
# Messages requested per conversations.replies call when replaying thread history. Slack clamps this per workspace: an app commercially distributed outside the Marketplace gets 15 whatever it asks for, an internal-app install gets the full page up to 1000, which is also the largest value Slack accepts. The default matches the 100 messages Discord replays; every replayed message is first-turn context the model pays for.
# DAIMON_SLACK__HISTORY_PAGE_LIMIT=100
# Port for the Slack process's liveness endpoint. Must not collide with the mcp process (8080), the discord process (8081), or the scheduler process (8082) — all process groups share one host.
# DAIMON_SLACK__HEALTH_PORT=8083

# === Teams (optional) ===
# Entra (Azure AD) app registration client ID the Teams bot authenticates as — also the audience inbound Bot Framework JWTs are validated against.
# DAIMON_TEAMS__CLIENT_ID=
# Entra app registration client secret, used to mint Bot Framework tokens for outbound sends. (secret)
# DAIMON_TEAMS__CLIENT_SECRET=
# Entra tenant ID the app registration lives in. A single-tenant bot only answers activities whose conversation and channel-data tenant both equal this value.
# DAIMON_TEAMS__TENANT_ID=
# Maximum number of agent turns a single Teams tenant may have in flight at once. Caps one noisy tenant from starving others on the shared Anthropic key.
# DAIMON_TEAMS__MAX_CONCURRENT_TURNS_PER_TENANT=3
# Port for the Teams process's HTTP ingress and health endpoints (/api/messages, /healthz, /readyz). The Bot Framework messaging endpoint must be configured to reach this listener.
# DAIMON_TEAMS__PORT=3978
# When False, /api/messages answers 503 while the health endpoints stay live — the process keeps running so ingress can be re-enabled without a redeploy.
# DAIMON_TEAMS__ENABLED=True
# Externally reachable base URL of the Teams service (the Bot Framework messaging endpoint without /api/messages). Graph's change notifications for private and shared channels post to it.
# DAIMON_TEAMS__PUBLIC_URL=
# Entra group ID of the team whose owners administer this deployment from Teams: admins get the admin role in turns, create routines, replace shared keys, top up and see everyone's usage. Adding an admin means making them an owner of that team; no redeploy. The app must be installed in that team. To find the ID, open the team's ⋯ menu in Teams, choose Get link to team and copy the groupId parameter. Unset: nobody is an admin.
# DAIMON_TEAMS__ADMIN_TEAM_ID=

# === GitHub (optional) ===
# Raw (compressed) size cap enforced while streaming a GitHub tarball download, checked against Content-Length when present and against the cumulative streamed byte count regardless. 50 MiB is the operator default. Set to 0 to disable (not recommended in production).
# DAIMON_GITHUB__MAX_TARBALL_BYTES=52428800
# Decompressed (extracted) size cap enforced against the sum of tar member sizes before extraction, guarding against zip bombs. 200 MiB is the operator default. Set to 0 to disable (not recommended in production).
# DAIMON_GITHUB__MAX_TARBALL_DECOMPRESSED_BYTES=209715200

# === GitHub App (optional) ===
# GitHub App ID for agent-scoped access.
# DAIMON_GITHUB_APP__APP_ID=
# GitHub App URL slug used for installation links.
# DAIMON_GITHUB_APP__APP_SLUG=
# GitHub App private key as PEM or base64-encoded PEM. (secret)
# DAIMON_GITHUB_APP__PRIVATE_KEY=
# Secret for verifying this App's webhook signatures. (secret)
# DAIMON_GITHUB_APP__WEBHOOK_SECRET=
# GitHub App client ID for user authorization.
# DAIMON_GITHUB_APP__CLIENT_ID=
# GitHub App client secret for user authorization. (secret)
# DAIMON_GITHUB_APP__CLIENT_SECRET=

# === Microsoft Accounts (optional) ===
# Application (client) ID of the Entra app registration people sign in to with Connect Microsoft. Its Web redirect URI is `<public root>/oauth/microsoft/callback`.
# DAIMON_MICROSOFT_ACCOUNTS__CLIENT_ID=
# Client secret of that app registration, sent as client_secret_post. (secret)
# DAIMON_MICROSOFT_ACCOUNTS__CLIENT_SECRET=
# Entra tenant ID (a GUID) people sign in to. Only accounts of this tenant whose object ID matches the Teams user asking can connect.
# DAIMON_MICROSOFT_ACCOUNTS__TENANT_ID=
# Microsoft identity platform host; change it only for a sovereign cloud.
# DAIMON_MICROSOFT_ACCOUNTS__AUTHORITY=https://login.microsoftonline.com

# === Crypto (optional) ===
# Ordered Fernet keys used to encrypt/decrypt stored credentials: a single key, a comma-separated list, or a JSON list. Required to save agent keys: without keys, saving an agent environment value is refused unless `allow_plaintext` is set. The first key encrypts new values; older keys remain valid for decrypting existing ciphertext during rotation. Run `daimon crypto verify` to confirm no plaintext rows remain. (secret)
# DAIMON_CRYPTO__KEYS=
# Store agent environment values (agent keys) in plaintext when no `keys` are configured. For local development only: with this off and no keys, every agent key write is refused.
# DAIMON_CRYPTO__ALLOW_PLAINTEXT=False

# === Credentials (optional) ===
# Full JSON contents of a Google service-account key, used by the token broker to mint delegated Google Workspace credentials. (secret)
# DAIMON_CREDENTIALS__GOOGLE_SA_JSON=

# === Selfhosted (optional) ===
# Allow explicitly configured selfhosted channels to pass backend admission. Default false. Enabling this still requires the profile's usage observations capability and a configured self-hosted core runtime.
# DAIMON_SELFHOSTED__ADMISSION_ENABLED=False
# Declare this self-hosted installation single-tenant. Required for wildcard MCP credential bindings; leave false for shared installations.
# DAIMON_SELFHOSTED__SINGLE_TENANT=False
# Operator-authorized exact hostnames or IP literals for credential-free HTTP MCP connections to private, link-local or metadata destinations. Empty by default. Loopback remains allowed; credential-bearing connections still require HTTPS.
# DAIMON_SELFHOSTED__MCP_ALLOWED_HTTP_HOSTS=
# JSON list of harness auth bindings: auth_mode (bearer_env or entra), name (DAIMON_SELFHOSTED__HARNESS_TOKEN_* variable or exact Entra audience), origin (exact HTTPS origin), tenants (UUID list). Unbound names and destinations are refused before credential resolution. Wildcards require single_tenant.
# DAIMON_SELFHOSTED__HARNESS_AUTH_BINDINGS=
# JSON list of operator MCP credential bindings: each has name (HARNESS_MCP_CRED_*), origin (exact HTTPS origin), and tenants (UUID list). Unbound references, other origins and other tenants are refused. Use tenants=["*"] only for a single-tenant installation. Configure the harness HARNESS_MCP_CRED_BINDINGS from the same operator source.
# DAIMON_SELFHOSTED__MCP_CREDENTIAL_BINDINGS=

# === Gemini (optional) ===
# Gemini API key used by media-generation MCP tools. Tools are unregistered when unset. (secret)
# DAIMON_GEMINI__API_KEY=

# === Notebook Host (optional) ===
# Base URL of the notebook-host service (e.g. http://notebook-host:8001).
# DAIMON_NOTEBOOK__HOST_URL=
# Bearer secret used to authenticate admin calls to the notebook-host service. (secret)
# DAIMON_NOTEBOOK__ADMIN_SECRET=
# Per-principal cap on publish_notebook calls per rolling hour. Prevents a compromised or buggy agent from exhausting the notebook host's process/port pool. Set to 0 to disable (not recommended in production).
# DAIMON_NOTEBOOK__PUBLISH_RATE_PER_HOUR=30
# Per-attachment size cap enforced by attach_notebook_data before uploading to the notebook host. 10 MiB is the operator default. Set to 0 to disable (the host's own ceiling still applies as defense-in-depth).
# DAIMON_NOTEBOOK__MAX_ATTACHMENT_BYTES=10485760
# Per-upload byte budget signed into notebook upload tokens. 1 MiB mirrors the notebook host's own ceiling, which is enforced independently as a second layer of defense.
# DAIMON_NOTEBOOK__MAX_SOURCE_BYTES=1048576
# Let `create_notebook_upload_url(editable=True)` publish the marimo code editor. Anyone holding an editor link can run arbitrary code on the notebook host, and any member or prompt-injected agent can ask for one, so this stays off unless every notebook on the host belongs to one client. Off: scratch notebooks are always read-only.
# DAIMON_NOTEBOOK__ALLOW_EDITABLE=False

# === Report Host (optional) ===
# Base URL of the report-host service (e.g. http://report-host:8002).
# DAIMON_REPORT_HOST__HOST_URL=
# Bearer secret used to authenticate admin calls to the report-host service. Must be the same value the report host itself is configured with (its DAIMON_REPORT__ADMIN_SECRETS) — rotating one without the other breaks publishing. (secret)
# DAIMON_REPORT_HOST__ADMIN_SECRET=

# === Sentry (optional) ===
# Sentry DSN. When unset, error reporting is disabled entirely. (secret)
# DAIMON_SENTRY__DSN=
# Environment tag attached to every Sentry event (e.g. 'production', 'staging').
# DAIMON_SENTRY__ENVIRONMENT=production
# Fraction (0.0-1.0) of transactions sampled for Sentry performance tracing.
# DAIMON_SENTRY__TRACES_SAMPLE_RATE=0.0

# === Billing Policy (optional) ===
# Multiplier applied to raw Anthropic usage cost before billing the tenant. 1.0 = pass-through.
# DAIMON_BILLING__MARKUP=1.0
# Maximum harness clock lag in seconds when associating usage with an existing tariff admission. Frozen at admission; default 5, maximum 60. This tolerance never creates an admission or selects current prices.
# DAIMON_BILLING__SELFHOSTED__ADMISSION_CLOCK_SKEW_S=5
# JSON object mapping selfhosted Azure deployment names to underlying model ids. Targets must have configured tariffs and aliases cannot shadow another model. The runtime must call the tariff admission gate before paid model work; these settings alone do not enable refusal or execution.
# DAIMON_BILLING__SELFHOSTED__DEPLOYMENTS={}
# JSON object keyed by underlying Azure OpenAI model id, each containing a list of historical tariffs. Each requires effective_from (ISO date), input, output and cache_read (USD per million tokens); optional valid_before expires a row. A newer effective_from ends the previous open window. Retain historical rows. Supply verified regional/contract rates; input/output must be positive. Runtime admission must persist the selected tariff before paid work.
# DAIMON_BILLING__SELFHOSTED__MODELS={}
# USD credit automatically seeded when a guild/workspace is provisioned, so a freshly-installed tenant can chat immediately on trial credit before paying. Set to 0 to require payment before use.
# DAIMON_BILLING__SIGNUP_CREDIT=10.00

# === Support (optional) ===
# Discord channel id where human-support requests from Discord are posted (the unprefixed name predates per-platform channels). A Teams id (`19:…`) left here is ignored. Unset (the default) disables the escalate affordance on Discord — a request that reaches nobody is worse than no button at all. A channel rather than operator DMs: it survives one person's DMs being closed, and it leaves a shared record anyone on the rota can pick up. The bot must be able to post there.
# DAIMON_SUPPORT__ESCALATION_CHANNEL_ID=
# Slack channel id where human-support requests from Slack are posted. Unset (the default) disables the Ask the team button on Slack. Slack requests never go to another platform's channel, nor theirs here. The bot must be a member of the channel.
# DAIMON_SUPPORT__SLACK_ESCALATION_CHANNEL_ID=
# Slack workspace id (T…) that owns DAIMON_SUPPORT__SLACK_ESCALATION_CHANNEL_ID, for a deployment installed in several workspaces: every workspace's requests are posted with that workspace's bot token. Unset posts with the requesting workspace's own token, which suits a single-workspace install. Daimon must be installed in the named workspace.
# DAIMON_SUPPORT__SLACK_ESCALATION_TEAM_ID=
# Teams channel id (`19:…`) where human-support requests from Teams are posted. Unset (the default) disables Ask a person on Teams. Teams requests never go to the Discord or Slack channel, nor theirs here. The Teams bot must be a member of the channel's team (and of the channel, if it is private).
# DAIMON_SUPPORT__TEAMS_ESCALATION_CHANNEL_ID=
# How many human-support requests each user gets within a tenant. A COUNT of interactions, NOT the USD in DAIMON_BILLING__SIGNUP_CREDIT — the two are deliberately separate ledgers. 0 disables escalation.
# DAIMON_SUPPORT__CREDITS_PER_USER=20
# Per-tenant switch, keyed by tenant UUID: true also posts every submitted 👎 "What went wrong?" form (the reasons, the text, the person, the agent and a link to the answer) to the channel Ask a human posts to: DAIMON_SUPPORT__SLACK_ESCALATION_CHANNEL_ID for Slack, DAIMON_SUPPORT__ESCALATION_CHANNEL_ID for Discord and DAIMON_SUPPORT__TEAMS_ESCALATION_CHANNEL_ID for Teams. Missing/false (the default) keeps the form in the database only. The form tells the person their answers are shared when it is on. Spends no support credit. Configure DAIMON_SUPPORT__FEEDBACK_TO_SUPPORT as a JSON object.
# DAIMON_SUPPORT__FEEDBACK_TO_SUPPORT={}

# === Turn (optional) ===
# Turn I/O path. mux (the default) runs turns through the neutral Events/Sessions ports; legacy selects the previous direct-SDK path, kept for rollback. Channel backend selection also needs channel_backends.
# DAIMON_TURN__PATH=mux
# Display settled native OpenAI/Gemini turn cost on platform footers. Requires complete normalized usage, verified rates and root accounting. Incomplete totals display Cost unknown or Cost partial, never an estimate. Off by default; Anthropic footers are unchanged with either value.
# DAIMON_TURN__NATIVE_FOOTER_COST=False
# Read each channel's backend configuration at admission. Needs path=mux. Off by default: no channel's configuration is read and every turn runs as before. On: a channel with no backend configuration is unchanged; a configured one is checked against its profile and refused (backend_unsupported) if the profile cannot meet it or this release cannot run it yet.
# DAIMON_TURN__CHANNEL_BACKENDS=False
# Capture complete scoped source and resource intent for an agent-selected native backend. Unproved obligations are refused; counterpart identity readback alone never authorizes execution. Requires mux and channel_backends; off by default.
# DAIMON_TURN__AGENT_BACKENDS=False
# Keep each message the agent writes apart in its answer. Off by default: consecutive messages from the agent are joined into one block of text. On: an answer made of several messages keeps every one, set apart by a blank line instead of being run together. Either way the "Working on it…" card shows the last three messages the agent wrote, oldest first, one line each (cut at 120 characters).
# DAIMON_TURN__STATUS_LOG=False

# === Thread Naming (optional) ===
# Title bot-created Discord threads from the opening message with a short Haiku-generated name, chosen before the thread is created. The call is metered to the tenant like any other model call. Set false to title threads with the opening message itself, cut to 50 characters.
# DAIMON_THREAD_NAMING__ENABLED=True
# Characters of the opening message sent to the naming model; longer messages are cut here. Bounds the per-thread naming cost.
# DAIMON_THREAD_NAMING__MAX_INPUT_CHARS=2000
# Seconds to wait for the naming model before the thread opens under a title taken from the opening message. The thread is created only after this call, so this is the most a mention can wait before anything appears.
# DAIMON_THREAD_NAMING__TIMEOUT_SECONDS=5.0

# === Turn Queue (optional) ===
# Queue turns that arrive while the global or the per-tenant concurrency cap is full, and start them as slots free. Set false to refuse them with the plain capacity notice instead.
# DAIMON_TURN_QUEUE__ENABLED=True
# Most turns one tenant (Discord server, Slack workspace, Teams tenant) may have waiting in one adapter process. A turn beyond it is refused with the plain capacity notice.
# DAIMON_TURN_QUEUE__MAX_PER_TENANT=50
# Most turns waiting across all tenants in one adapter process. A turn beyond it is refused with the plain capacity notice.
# DAIMON_TURN_QUEUE__MAX_TOTAL=500
# Seconds a queued turn may wait for a slot. A safeguard only: the turn then leaves the queue and its card ends with the ordinary error.
# DAIMON_TURN_QUEUE__MAX_WAIT_S=300.0

# === Fleet (optional) ===
# Allow orchestrator turns to start worker fleets. Off by default.
# DAIMON_FLEET__ENABLED=False
# Most workers one fleet run may start.
# DAIMON_FLEET__MAX_WORKERS_PER_RUN=8
# Most worker turns one tenant may have starting or running at once, across all its fleet runs and processes. Separate from the chat turn cap.
# DAIMON_FLEET__MAX_CONCURRENT_WORKERS_PER_TENANT=3
# Most worker turns one process runs at once, across all tenants.
# DAIMON_FLEET__MAX_CONCURRENT_WORKERS=6
# Most times in total a worker is started when it keeps being lost before its turn is sent. A worker whose turn was sent is reconciled, never resent.
# DAIMON_FLEET__MAX_ATTEMPTS=2

# === Private Channel Messages (optional) ===
# When True, Daimon subscribes to Microsoft Graph change notifications for each Teams private or shared channel it is in, where Teams sends the bot only the posts that @mention it. Replies in followed threads, replies to Daimon's messages and typed @<bot name> mentions then work there too, usually within seconds. Needs DAIMON_TEAMS__PUBLIC_URL (Graph posts to <public_url>/api/graph/notifications and /api/graph/lifecycle) and the application permission ChannelMessage.Read.All with tenant admin consent.
# DAIMON_PRIVATE_CHANNEL_MESSAGES__ENABLED=False

# === Tool Safety (optional) ===
# Classify attached (third-party) MCP tools as read or write and gate the writes: a write in chat waits for the requester to press Approve on a confirmation card, and a write in a routine or other unattended run is refused unless listed in unattended_writes. Applies to sessions created after it is set; a chat thread keeps its current session until that is replaced. Off keeps every tool auto-approved.
# DAIMON_TOOL_SAFETY__ENABLED=False
# Apply workspace-admin tool rules for individual agents and MCP tools: third-party tools, and Daimon's own daimon-mcp/<tool> (ask and deny). Off by default; stored rules remain editable but inactive until enabled.
# DAIMON_TOOL_SAFETY__AGENT_RULES=False
# Override the read/write class, e.g. {"linear/get_team": "read", "notion": "write"}. Keys are a server name or server/tool. Unlisted tools are classified from their name: a plain get_, list_, search_ ... is a read; a compound name (get_or_create, search_and_replace, run_query) and anything unknown is a write.
# DAIMON_TOOL_SAFETY__EFFECTS={}
# Servers or server/tool pairs that are always refused, e.g. ["hubspot/delete_deal"].
# DAIMON_TOOL_SAFETY__DENIED=
# Servers or server/tool pairs whose writes may run in routines and other unattended runs, e.g. ["linear/create_issue"]. "*" allows every write there. Daimon's own add_skill never confirms unattended.
# DAIMON_TOOL_SAFETY__UNATTENDED_WRITES=
# How long an approval card waits for the requester's Approve or Deny, in seconds, before it expires and the call is refused. Production keeps the 10-minute default; staging can set it short (60-90) so a precheck or load test does not hold a turn for ten minutes.
# DAIMON_TOOL_SAFETY__CONFIRMATION_TIMEOUT_S=600

# === Artifacts (optional) ===
# Artifact storage backend: s3 (default) or azure_blob.
# DAIMON_ARTIFACTS__BACKEND=s3
# S3-compatible endpoint or Azure Blob account URL (https://<account>.blob.core.windows.net); used for uploads and signed GET URLs.
# DAIMON_ARTIFACTS__ENDPOINT_URL=
# Private S3 bucket or Azure Blob container name; provision it before startup.
# DAIMON_ARTIFACTS__BUCKET=
# S3 access key id; required only for the s3 backend. (secret)
# DAIMON_ARTIFACTS__ACCESS_KEY_ID=
# S3 secret access key; required only for the s3 backend. (secret)
# DAIMON_ARTIFACTS__SECRET_ACCESS_KEY=
# Local Azurite connection string only; BlobEndpoint must match the loopback endpoint_url. Leave unset on Azure; managed identity signs user-delegation SAS without account keys. (secret)
# DAIMON_ARTIFACTS__AZURE_CONNECTION_STRING=
# User-assigned managed identity client id; required for azure_blob except local Azurite. ManagedIdentityCredential uses only this identity, with no environment service-principal or developer-login fallback.
# DAIMON_ARTIFACTS__AZURE_CLIENT_ID=
# S3 signing region supplied by the bucket provider.
# DAIMON_ARTIFACTS__REGION=us-east-1
# Lifetime of each presigned artifact GET URL; defaults to ten minutes.
# DAIMON_ARTIFACTS__URL_TTL_SECONDS=600
# Also return bounded MCP image blocks for model vision. Disable independently when a hosted client cannot accept image content.
# DAIMON_ARTIFACTS__EMBED_IMAGES=True

# === Scheduler (optional) ===
# Seconds between scheduler ticks (loop sleep). The usage sweep runs on its own loop and pauses the same interval between passes.
# DAIMON_SCHEDULER__TICK_INTERVAL_S=30.0
# Run the headless usage sweep: settle the MCP agent-chat sessions whose turns nobody read to the end (each headless send leaves a settle request; a status read that sees the turn end settles it first). It reads only the sessions those requests name. When off, such a session is billed the next time a read sees its last turn ended.
# DAIMON_SCHEDULER__USAGE_SWEEP_ENABLED=True
# Freshness window for routines with catch_up_policy=skip. Older slots are recorded as skipped and advanced; run-once routines ignore this window.
# DAIMON_SCHEDULER__MAX_AGE_S=900.0
# Global cap on simultaneously-dispatched routine fires across all ticks. Conservative against the shared Anthropic key's rate limit; per-tenant caps are enforced separately by the adapters.
# DAIMON_SCHEDULER__MAX_CONCURRENT_FIRES=10
# An OUTER PROCESS GUARD (asyncio.wait_for), not the turn's deadline. The core ~45-minute ceiling (daimon.core.turn.ceiling) is enforced inside headless_runner.run_turn and fires first, producing a TurnError(kind='ceiling'). This bound only catches a fire that hangs OUTSIDE the ceiling's two legs (routine row bookkeeping, agent/environment resolution, the usage-recorder factory, record_result), and must stay strictly above TURN_CEILING_S or the core ceiling becomes unreachable for routines. Each routine has its own timeout; continuous scheduler ticks do not await in-flight routines. Missed slots follow the routine's catch_up_policy.
# DAIMON_SCHEDULER__DISPATCH_TIMEOUT_S=3000.0
# Postgres pg_try_advisory_lock int64 key. Default is the ASCII encoding of 'DAIMONSC'. Two scheduler processes share the key; the second logs that it did not get the lock and exits non-zero.
# DAIMON_SCHEDULER__ADVISORY_LOCK_KEY=4918292864457134915
# Port for the stdlib liveness responder (used by the platform health check). Must not collide with mcp's 8080 or discord's 8081 on the shared host.
# DAIMON_SCHEDULER__HEALTH_PORT=8082

# === Billing (optional — Stripe top-ups) ===
# 7-key flat env read by daimon.core.billing.load_billing_config.
# No DAIMON_ prefix. Billing is disabled (not an error) when any is unset.
# With billing disabled, /billing top-ups can't create a checkout. Credit
# manually: insert a tenant_ledger row (delta_usd > 0, reason='topup', a
# unique idempotency_key — its unique index makes a re-run a no-op).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_10_USD=
# STRIPE_PRICE_25_USD=
# STRIPE_PRICE_50_USD=
# STRIPE_PRICE_100_USD=
# MCP_PUBLIC_URL=

# === Docker Compose (not read by the app) ===
POSTGRES_USER=daimon
# Required by docker-compose.yml. Set a strong, URL-safe value
# (avoid @ : / % # — it is interpolated raw into the asyncpg DSN).
# POSTGRES_PASSWORD=
POSTGRES_DB=daimon
POSTGRES_PORT=5432
